---
interface Props { title: string; aside?: string; }
const { title, aside } = Astro.props;
---
<div class="flex items-baseline gap-4 pb-6">
  <h2 class="lbl" style="color: var(--hi); font-size: 12.5px; font-weight: 600">{title}</h2>
  <div class="flex-1 h-px" style="background: var(--edge)"></div>
  {aside && <span class="lbl">{aside}</span>}
</div>
