---
/** Mișcarea de design nr. 1: antetul de secțiune numerotat, ca într-un
 *  document de specificație. Index mono roșu + titlu mono + hairline. */
interface Props { index: string; title: string; }
const { index, title } = Astro.props;
---
<div class="sec-head">
  <span class="idx" aria-hidden="true">{index}</span>
  <h2 class="ttl">{title}</h2>
  <div class="rule"></div>
</div>
