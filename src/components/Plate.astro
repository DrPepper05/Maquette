---
/**
 * O lucrare montată pe perete + cartelul ei.
 *
 * `kind` NU e text liber: vine din copy.gallery.kinds. Valoarea `delivered`
 * se pune doar pe muncă livrată efectiv unui client, cu acord scris de
 * publicare. Vezi CLAUDE.md § Regula de aur.
 */
interface Props {
  index: string;
  title: string;
  kind: string;
  tech: string;
  col: number;
  span: number;
  off?: number;
  row?: number;
  speed?: number;
  bleed?: 'l' | 'r';
}
const { index, title, kind, tech, col, span, off = 0, row, speed = 1, bleed } = Astro.props;

// deriva de parallax, derivată din viteză; 1 = nemișcat
const drift = Math.round((1 - speed) * 460);

const style = [
  `--col:${col}`,
  `--span:${span}`,
  `--off:${off}px`,
  `--drift:${drift}px`,
  row ? `grid-row:${row}` : '',
].filter(Boolean).join(';');
---
<div class:list={['hang', bleed && `bleed-${bleed}`]} style={style} data-speed={speed}>
  <div class="plate"><slot /></div>

  <figcaption class="cartel">
    <div class="row"><span class="idx">{index}</span><span class="rule"></span></div>
    <h3>{title}</h3>
    <p class="kind">{kind}</p>
    <p class="tech">{tech}</p>
  </figcaption>
</div>
