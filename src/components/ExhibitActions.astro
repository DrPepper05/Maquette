---
/** Acțiunile unui exponat de pe /projects: Contact (mereu) + Like + Comment.
 *  Like și Comment sunt gate-uite pe env, ca formularul de contact:
 *  fără PUBLIC_LIKES_ENDPOINT / PUBLIC_CUSDIS_APP_ID butoanele nu se
 *  randează deloc — zero JS de terți. Logica stă în pages/projects.astro. */
import { copy, routes } from '../copy';

interface Props { slug: string; }
const { slug } = Astro.props;
const t = copy.projects.actions;
const likes = import.meta.env.PUBLIC_LIKES_ENDPOINT;
const cusdis = import.meta.env.PUBLIC_CUSDIS_APP_ID;
const site = 'https://maquette.ro';
---
<div class="ex-actions" data-exhibit={slug}>
  <a href={routes.contact} class="btn">{t.contact}</a>
  {likes && (
    <button type="button" class="act" data-like data-endpoint={likes}>
      <span aria-hidden="true">♥</span> {t.like} <b class="tabular" data-count>00</b>
    </button>
  )}
  {cusdis && (
    <button type="button" class="act" data-comment aria-expanded="false">{t.comment}</button>
  )}
</div>
{cusdis && (
  <div class="ex-thread mt-8" hidden data-thread>
    <div
      class="cusdis-thread"
      data-host="https://cusdis.com"
      data-app-id={cusdis}
      data-page-id={slug}
      data-page-url={`${site}${routes.projects}#ex-${slug}`}
      data-page-title={slug}
    ></div>
    <p class="lbl mt-3">{t.commentNote}</p>
  </div>
)}
