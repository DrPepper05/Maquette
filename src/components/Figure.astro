---
/** Mișcarea de design nr. 2: figura — rama întunecată cu un ecran live
 *  înăuntru și legenda mono dedesubt, ca într-un document tipărit.
 *  `kind` are exact trei valori (copy.kinds) — nu e text liber.
 *  `delivered` nu se folosește fără acord scris de publicare. */
import { kinds, type Kind } from '../copy';

interface Props { index: string; title: string; kind: Kind; tech: string; }
const { index, title, kind, tech } = Astro.props;
---
<figure class="figure">
  <div class="screen"><slot /></div>
  <figcaption>
    <span class="fig-id">FIG. {index} · {title}</span>
    <span>{kinds[kind]} — {tech}</span>
  </figcaption>
</figure>
