---
/** Diagrama Înainte / După — SVG scris de mână, fără librărie de grafuri.
 *  Stânga: totul trece printr-un singur om. Dreapta: o magistrală, omul decide.
 *  Roșul marchează un singur lucru: nodul care doare.
 *
 *  Atenție: stilurile stau ca atribute de prezentare, nu ca <style> în <defs>.
 *  Astro extrage și scopează orice <style> dintr-o componentă, iar selectorii
 *  nu mai ajung la elementele SVG — nodurile ies negre și textul invizibil. */
import { copy } from '../../copy';
const f = copy.screens.flow;

const MONO = '"JetBrains Mono", ui-monospace, monospace';
const node = { fill: '#16181C', stroke: '#31343A', rx: 8, width: 140, height: 36 };
const nt   = { 'font-family': MONO, 'font-size': 11, 'letter-spacing': '.1em', fill: '#C9CDD3', 'text-anchor': 'middle' };
const et   = { 'font-family': MONO, 'font-size': 9.5, 'letter-spacing': '.08em', fill: '#6E747C' };
const ht   = { 'font-family': MONO, 'font-size': 11, 'letter-spacing': '.16em', fill: '#8B8F94' };
const st   = { 'font-family': MONO, 'font-size': 13, 'letter-spacing': '.08em', fill: '#C9CDD3' };
const edge = { stroke: '#3A3E45', 'stroke-width': 1.4, fill: 'none' };
---
<div class="scr">
  <div class="scr-bar"><span>{f.bar}</span><b>{f.side}</b></div>

  <div class="dgm">
    <svg viewBox="0 0 1040 430" role="img" aria-label={f.bar}>
      <defs>
        <marker id="ba-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" fill="#6E747C" />
        </marker>
        <marker id="ba-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" fill="#D9573A" />
        </marker>
      </defs>

      {/* ═══ ÎNAINTE — totul prin acelaşi om ═══ */}
      <text {...ht} x="24" y="20">{f.before}</text>

      <rect {...node} x="24" y="44" /><text {...nt} x="94" y="67">{f.orders}</text>
      <rect {...node} x="24" y="166" /><text {...nt} x="94" y="189">{f.erp}</text>
      <rect {...node} x="24" y="288" /><text {...nt} x="94" y="311">{f.stockBad}</text>
      <rect {...node} x="336" y="44" /><text {...nt} x="406" y="67">{f.quotes}</text>
      <rect {...node} x="336" y="288" /><text {...nt} x="406" y="311">{f.invoices}</text>

      <rect x="190" y="158" width="120" height="52" rx="10" fill="rgba(217,87,58,.10)" stroke="#D9573A" stroke-width="1.4" />
      <text {...nt} x="250" y="180" fill="#E9856E">{f.person}</text>
      <text {...et} x="250" y="197" text-anchor="middle" fill="#B8705E">{f.personSub}</text>

      <path {...edge} d="M164 62 H177 V184 H190" marker-end="url(#ba-r)" />
      <path {...edge} d="M164 184 H190" marker-end="url(#ba-r)" />
      <path {...edge} d="M164 306 H177 V184 H190" marker-end="url(#ba-r)" />
      <path {...edge} d="M310 184 H323 V62 H336" marker-end="url(#ba-a)" />
      <path {...edge} d="M310 184 H323 V306 H336" marker-end="url(#ba-a)" />

      <text {...et} x="180" y="120">{f.eManual}</text>
      <text {...et} x="180" y="256">{f.eRetyped}</text>

      <text {...st} x="24" y="404" fill="#E9856E">{f.sumBefore}</text>
      <text {...et} x="24" y="422">{f.sumBeforeSub}</text>

      <path d="M520 30 V400" stroke="#26292E" stroke-width="1" stroke-dasharray="3 5" />

      {/* ═══ DUPĂ — o magistrală, omul mutat deoparte ═══ */}
      <text {...ht} x="564" y="20">{f.after}</text>

      <rect {...node} x="564" y="44" /><text {...nt} x="634" y="67">{f.orders}</text>
      <rect {...node} x="564" y="166" /><text {...nt} x="634" y="189">{f.erp}</text>
      <rect {...node} x="564" y="288" /><text {...nt} x="634" y="311">{f.stock}</text>
      <rect {...node} x="876" y="44" /><text {...nt} x="946" y="67">{f.quotes}</text>
      <rect {...node} x="876" y="288" /><text {...nt} x="946" y="311">{f.invoices}</text>

      <rect x="782" y="44" width="10" height="280" rx="5" fill="#C9CDD3" />
      <text {...et} x="787" y="34" text-anchor="middle">{f.bus}</text>

      <path {...edge} d="M704 62 H782" marker-end="url(#ba-a)" />
      <path {...edge} d="M704 184 H782" marker-end="url(#ba-a)" />
      <path {...edge} d="M704 306 H782" marker-end="url(#ba-a)" />
      <path {...edge} d="M792 62 H876" marker-end="url(#ba-a)" />
      <path {...edge} d="M792 306 H876" marker-end="url(#ba-a)" />

      <text {...et} x="716" y="146">{f.eAuto}</text>
      <text {...et} x="800" y="146">{f.eAuto}</text>

      <rect {...node} x="727" y="352" width="120" height="32" />
      <text {...nt} x="787" y="373" font-size="10">{f.decide}</text>
      <path d="M787 352 V324" stroke="#3A3E45" stroke-width="1.4" stroke-dasharray="3 4" fill="none" />

      <text {...st} x="876" y="404" text-anchor="end">{f.sumAfter}</text>
      <text {...et} x="876" y="422" text-anchor="end">{f.sumAfterSub}</text>
    </svg>
    <p class="dgm-hint">{f.hint}</p>
  </div>
</div>
