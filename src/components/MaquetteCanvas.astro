---
/**
 * MaquetteCanvas.astro — "Pages of the prospectus"
 * ────────────────────────────────────────────────────────────────────────
 * 4 dark pages float scattered in 3D. Far away — and parked-aside, and in
 * the finale — each page shows a designed ALBUM COVER (ghost numeral,
 * plate caption, a small house-illustration motif, in the /projects cover
 * language) instead of a blind blur smudge (2026-08-28: covers-only read
 * as "simple cards"). Only DURING approach does the cover melt into a
 * blur — an abstract smudge of the real text — which then resolves to
 * crisp text as the page PARKS at text size (computed park pose — never
 * full-screen); on leave it blurs back, the cover returns, and the page
 * leaves WITH the text. The HTML inners are hidden while the canvas runs
 * (visible for no-JS/reduced-motion) — the page texture is the only
 * visible text for §01–§03. The 4th page is a table of contents; the
 * finale connects everything before the CTA.
 */
---

<div id="mq-wrap" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <canvas id="mq-c" class="w-full h-full block"></canvas>
  <!-- Paper vignette — fades out while a card covers the screen, so the
       dark background stays flat instead of greying at the edges. -->
  <div id="mq-vig" class="absolute inset-0 pointer-events-none"
       style="background: radial-gradient(ellipse 90% 80% at 55% 40%, transparent 0%, rgba(244,242,237,0.25) 40%, rgba(244,242,237,0.82) 100%); will-change: opacity;"></div>
  <div id="mq-hud" class="absolute bottom-5 right-6 hidden md:flex items-center gap-4 font-mono text-[10.5px] tracking-[.14em] uppercase"
       style="color: var(--mid,#5C5A54); opacity:0; transition:opacity .8s;">
    <span class="inline-block w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--red,#B34530);"></span>
    <span id="mq-hs">WIREFRAME</span>
    <span style="color:var(--hairline,#D8D5CC);">│</span>
    <span id="mq-hp">0 %</span>
  </div>

</div>

<!-- DOM twins of the parked pages. While a page is exactly parked, its
     twin — the section's REAL reparented HTML, recolored to the screen
     palette — fades in over the (static) card: native-sharp, clickable,
     selectable. It fades out before the card ever moves again. The
     inners are moved here at boot; without JS they stay in their
     sections and the page renders normally. -->
<div id="mq-pages">
  <div class="mq-page" id="mq-page-0" style="--pg-h: 72px"><div class="mq-page-scale"></div></div>
  <div class="mq-page" id="mq-page-1" style="--pg-h: 52px"><div class="mq-page-scale"></div></div>
  <div class="mq-page" id="mq-page-2" style="--pg-h: 48px"><div class="mq-page-scale"></div></div>
  <div class="mq-page" id="mq-page-3" style="--pg-h: 48px"><div class="mq-page-scale"></div></div>
</div>

<script>
import * as THREE from 'three';
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { copy } from '../copy';

gsap.registerPlugin(ScrollTrigger);

function boot() {
  const cv = document.getElementById('mq-c') as HTMLCanvasElement | null;
  if (!cv || (cv as any).__mq) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  // Sub 1024px, formula de parcare (texW·1.12, plafon .94·vw) ar scala
  // textul parcat la ~6-9px — ilizibil. Telefoanele și tabletele primesc
  // HTML-ul static: boot() iese înainte de reparentare, aceeași cale ca
  // no-JS/reduced-motion (audit 2026-08-31).
  if (innerWidth < 1024) return;
  // Cronologia e cuplată la secțiunile homepage-ului (s01…cta). Pe orice
  // altă pagină (Base injectează componenta peste tot) nu pornim nimic —
  // altfel o pagină-geamăn goală parchează peste conținut.
  if (!document.getElementById('s01') || !document.getElementById('s01-inner')) return;
  (cv as any).__mq = true;

  // ─── Palette ───
  const P = { paper: 0xF4F2ED, ink: 0x141412, mid: 0x5C5A54, hl: 0xD8D5CC, red: 0xB34530, scr: 0x0F1013, scrHi: 0xF2F0EC, scrRed: 0xD9573A };

  // ─── Renderer / Scene / Camera / Lights ───
  // alpha:true + no scene background: the document's real --paper shows
  // through, so the canvas "paper" can't drift from the CSS paper via tone
  // mapping. dpr capped at 1.5 — retina fill cost drops ~44%, MSAA stays.
  const R = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true, powerPreference: 'high-performance' });
  R.setSize(innerWidth, innerHeight);
  R.setPixelRatio(Math.min(devicePixelRatio, 1.5));
  R.toneMapping = THREE.ACESFilmicToneMapping;
  R.toneMappingExposure = 1.15;

  const S = new THREE.Scene();
  S.fog = new THREE.FogExp2(P.paper, 0.008);

  const cam = new THREE.PerspectiveCamera(32, innerWidth / innerHeight, 0.1, 400);
  S.add(new THREE.AmbientLight(0xffffff, 0.95));
  const sun = new THREE.DirectionalLight(0xfff8ee, 2.0); sun.position.set(20, 35, 25); S.add(sun);
  const fill = new THREE.DirectionalLight(0xe0e6ff, 0.6); fill.position.set(-15, 12, -10); S.add(fill);
  const rPt = new THREE.PointLight(P.red, 0, 45); rPt.position.set(0, 2, 0); S.add(rPt);

  const root = new THREE.Group();
  S.add(root);

  // ═══════════════════════════════════════════════════════════════
  //  CARD FACES — each diving card is its own section in miniature:
  //  REAL copy (imported from copy.ts, honesty rule respected), drawn
  //  small with the site's own faces. Zooming in reads as "the small
  //  text on the card came close and became the section". The 4th card
  //  is a table-of-contents page — the whole scene is the prospectus.
  //  Every diving card ALSO gets an ALBUM COVER face (paintCover01…04,
  //  below) — the face it shows while far, parked-aside, or in the
  //  finale, so the floating scene reads as an album of covers, not
  //  blind blur smudges. Covers share the /projects cover language:
  //  ghost numeral, plate caption, sparse house-illustration motif.
  // ═══════════════════════════════════════════════════════════════

  const SCR = { bg: '#0F1013', hi: '#F2F0EC', body: '#C7CACF', mid: '#8B8F94', ln: '#262B33', red: '#D9573A' };
  // Astro's font loader registers faces under HASHED family names — the
  // canvas must use the same resolved names or it silently falls back to
  // a metrically different system font (and the DOM crossfade reflows).
  function realFamily(cssVar: string, fb: string) {
    const probe = document.createElement('span');
    probe.style.fontFamily = `var(${cssVar})`;
    document.body.appendChild(probe);
    const fam = getComputedStyle(probe).fontFamily.split(',')[0].trim().replace(/^["']|["']$/g, '');
    probe.remove();
    return fam ? `"${fam}", ${fb}` : fb;
  }
  const F_HEAD = realFamily('--font-figtree', 'system-ui, sans-serif');
  const F_MONO = realFamily('--font-jbmono', 'ui-monospace, monospace');
  type Ctx = CanvasRenderingContext2D;
  function bar(c: Ctx, x: number, y: number, w: number, h: number, r: number, fill: string) {
    c.beginPath(); c.roundRect(x, y, w, h, r); c.fillStyle = fill; c.fill();
  }
  // Datum cross — small plus-mark, the /projects cover-illustration language.
  function datumCross(c: Ctx, x: number, y: number, r: number, alpha: number) {
    c.strokeStyle = `rgba(139,143,148,${alpha})`; c.lineWidth = 2;
    c.beginPath();
    c.moveTo(x - r, y); c.lineTo(x + r, y);
    c.moveTo(x, y - r); c.lineTo(x, y + r);
    c.stroke();
  }
  function wrapText(c: Ctx, text: string, maxW: number): string[] {
    const out: string[] = []; let cur = '';
    for (const w of text.split(' ')) {
      const t = cur ? cur + ' ' + w : w;
      if (c.measureText(t).width > maxW && cur) { out.push(cur); cur = w; }
      else cur = t;
    }
    if (cur) out.push(cur);
    return out;
  }
  // Numbered kicker + hairline — same furniture as SectionHead.
  function kicker(c: Ctx, x: number, y: number, idx: string, label: string, W: number, MR: number, size = 15) {
    (c as any).letterSpacing = '2px';
    c.font = `600 ${size}px ${F_MONO}`;
    c.fillStyle = SCR.red; c.fillText(idx, x, y);
    const iw = c.measureText(idx).width + size;
    c.fillStyle = SCR.mid; c.fillText(label.toUpperCase(), x + iw, y);
    const lw = c.measureText(label.toUpperCase()).width;
    (c as any).letterSpacing = '0px';
    c.strokeStyle = SCR.ln; c.lineWidth = 2;
    c.beginPath(); c.moveTo(x + iw + lw + 28, y - size * .3); c.lineTo(W - MR, y - size * .3); c.stroke();
  }
  function heading(c: Ctx, x: number, y: number, text: string, size: number, maxW: number, color = SCR.hi): number {
    // letter-spacing matches the DOM twin's .t-h2 (-.028em) so canvas and
    // CSS break the same lines — the park crossfade must not reflow.
    // Returns the block BOTTOM (top + lines·lineHeight), which is exact
    // regardless of the ascent approximation used for baselines.
    (c as any).letterSpacing = `${(size * -.028).toFixed(1)}px`;
    c.font = `700 ${size}px ${F_HEAD}`;
    c.fillStyle = color;
    const lh = Math.round(size * 1.14);
    const top = y - ASC(size);
    const lines = wrapText(c, text, maxW);
    for (const line of lines) { c.fillText(line, x, y); y += lh; }
    (c as any).letterSpacing = '0px';
    return top + lines.length * lh;
  }
  function leader(c: Ctx, x1: number, x2: number, y: number) {
    c.strokeStyle = SCR.ln; c.lineWidth = 2; c.setLineDash([2, 8]);
    c.beginPath(); c.moveTo(x1, y); c.lineTo(x2, y); c.stroke();
    c.setLineDash([]);
  }

  // Shared layout constants, derived from the DOM twin's own metrics so
  // the park crossfade texture ⇄ HTML doesn't shift: top padding 4% of
  // the page width (was 7% — trimmed so the parked card fits below the
  // sticky header without shrinking the text; the twin shell's top
  // padding stays exactly 3%·W less), kicker row 25px tall, 42px below
  // it the heading. Baselines approximate first-line baseline as
  // top + .80em (ascent + half-leading at the used line-heights).
  const ASC = (size: number) => Math.round(size * .91);
  function pageTop(c: Ctx, W: number, MR: number, idx: string, label: string, hSize: number) {
    const ML = Math.round(W * .15), PT = Math.round(W * .04);
    kicker(c, ML, PT + 19, idx, label, W, MR);
    return { ML, hBase: PT + 25 + 42 + ASC(hSize) };
  }
  function drawLink(c: Ctx, x: number, base: number, text: string, alignRight = 0) {
    c.font = `600 15px ${F_HEAD}`;
    const lw = c.measureText(text).width;
    if (alignRight) x = alignRight - lw - 24;
    c.fillStyle = SCR.hi; c.fillText(text, x, base);
    c.fillStyle = SCR.red; c.fillText('→', x + lw + 10, base);
    c.strokeStyle = SCR.ln; c.lineWidth = 1.5;
    c.beginPath(); c.moveTo(x, base + 9); c.lineTo(x + lw + 24, base + 9); c.stroke();
  }

  // ── §01 page — the what-we-build menu (tags, not prices) ──
  function paintSec01(c: Ctx, W: number, H: number) {
    const t = copy.home.build, MR = Math.round(W * .15);
    const { ML, hBase } = pageTop(c, W, MR, '01', t.label, 72);
    const hBottom = heading(c, ML, hBase, t.h, 72, W - ML - MR);
    const rowsTop = hBottom + 48;                     // .rate mt-12
    const rows: [string, string, string][] = [...t.rows, [t.customWhat, t.customCta + ' →', '']];
    c.lineWidth = 2;
    for (let i = 0; i < rows.length; i++) {
      const top = rowsTop + i * 62, y = top + 36;     // 16 pad + half-leading + ascent
      c.strokeStyle = SCR.ln;
      c.beginPath(); c.moveTo(ML, top); c.lineTo(W - MR, top); c.stroke();
      const last = i === rows.length - 1;
      (c as any).letterSpacing = '-0.2px';
      c.font = `600 17px ${F_HEAD}`; c.fillStyle = SCR.hi;
      c.fillText(rows[i][0], ML, y);
      (c as any).letterSpacing = '0px';
      const ww = c.measureText(rows[i][0]).width;
      c.font = `600 17px ${F_MONO}`; c.fillStyle = last ? SCR.red : SCR.hi;
      const pw = c.measureText(rows[i][1]).width;
      c.fillText(rows[i][1], W - MR - pw, y);
      leader(c, ML + ww + 24, W - MR - pw - 24, y - 5);
      if (rows[i][2]) {
        c.font = `500 11px ${F_MONO}`; c.fillStyle = SCR.mid;
        const sw = c.measureText(rows[i][2].toUpperCase()).width;
        c.fillText(rows[i][2].toUpperCase(), W - MR - sw, y + 20);
      }
    }
    const rateBottom = rowsTop + rows.length * 62;
    c.strokeStyle = SCR.ln;
    c.beginPath(); c.moveTo(ML, rateBottom); c.lineTo(W - MR, rateBottom); c.stroke();
    c.font = `400 15.5px ${F_HEAD}`; c.fillStyle = SCR.mid;
    let ny = rateBottom + 32 + 19;                    // note mt-8 + half-leading + ascent
    const noteW = c.measureText('0').width * 60;      // = DOM max-w-[60ch]
    for (const line of wrapText(c, t.note, noteW)) { c.fillText(line, ML, ny); ny += 26; }
  }

  // ── §02 page — the Blueprint sentence ──
  function paintSec02(c: Ctx, W: number, H: number) {
    const t = copy.home.mech, MR = Math.round(W * .15);
    const { ML, hBase } = pageTop(c, W, MR, '02', t.label, 52);
    const hBottom = heading(c, ML, hBase, t.h, 52, W - ML - MR);
    drawLink(c, ML, hBottom + 32 + 19, t.link);       // .lnk mt-8
  }

  // ── §03 page — proof, landscape: heading left, stamp right, the two
  // product columns beneath (full real paragraphs, no truncation) ──
  // The honesty stamp is painted from the DOM twin's MEASURED geometry
  // (captured in layoutPages) — the painter's old hard-coded stamp
  // (12/32px, −2.3°, fixed 250×92 box) differed from the twin's .stamp
  // (10/28px, −5°, flex-placed auto box), so the park crossfade showed
  // two stamps sliding into each other.
  interface StampLine { size: number; wt: number; ls: number; base: number; }
  let stampM: { cx: number; cy: number; w: number; h: number; bw: number; r: number; rot: number; lines: StampLine[] } | null = null;
  // Product columns + bottom row of §03, measured the same way (the first
  // article anchors both grid columns; y-values logical, relative to page).
  let proofM: { rowTop: number; nameDy: number; pDy: number; pLh: number; exBase: number; exLh: number; exW: number; linkBase: number } | null = null;
  let stampSig = '';
  function paintSec03(c: Ctx, W: number, H: number) {
    const t = copy.home.proof, MR = Math.round(W * .15);
    const { ML, hBase } = pageTop(c, W, MR, '03', t.label, 48);
    const hBottom = heading(c, ML, hBase, t.h, 48, W - ML - MR - 282);
    // the honesty stamp, miniature, top-right of the heading row — drawn
    // only once its twin geometry is measured (layoutPages runs, and
    // repaints this page, before the first frame ever renders).
    if (stampM) {
      c.save();
      c.translate(stampM.cx, stampM.cy); c.rotate(stampM.rot);
      c.strokeStyle = SCR.red; c.lineWidth = stampM.bw;
      // CSS draws the border INSIDE the box; stroke on the centerline box
      const bw = stampM.w - stampM.bw, bh = stampM.h - stampM.bw;
      c.beginPath(); c.roundRect(-bw / 2, -bh / 2, bw, bh, Math.max(stampM.r - stampM.bw / 2, 0)); c.stroke();
      c.textAlign = 'center'; c.fillStyle = SCR.red;
      for (let i = 0; i < stampM.lines.length; i++) {
        const ln = stampM.lines[i];
        (c as any).letterSpacing = `${ln.ls}px`;
        c.font = `${ln.wt} ${ln.size}px ${F_MONO}`;
        c.fillText((t.stamp[i] ?? '').toUpperCase(), 0, ln.base - stampM.cy);
      }
      c.textAlign = 'left'; (c as any).letterSpacing = '0px';
      c.restore();
    }
    // product columns — anchored on the twin's MEASURED first article when
    // available (border-top, name/paragraph baselines, real line-height);
    // the old approximations (+22+46, 26px lines) sat everything ~10-20px
    // below the twin and the park crossfade showed the drift.
    const gap = 56, colW = (W - ML - MR - gap) / 2;
    const colsTop = proofM ? proofM.rowTop : hBottom + 40;
    const pLh = proofM ? proofM.pLh : 26;
    let gridBottom = colsTop;
    t.cards.forEach((card, i) => {
      const x = ML + i * (colW + gap);
      c.strokeStyle = SCR.ln; c.lineWidth = 2;
      c.beginPath(); c.moveTo(x, colsTop); c.lineTo(x + colW, colsTop); c.stroke();
      c.font = `700 28px ${F_HEAD}`; c.fillStyle = SCR.hi;
      const nBase = colsTop + (proofM ? proofM.nameDy : 68);
      c.fillText(card.name, x, nBase);
      const nw = c.measureText(card.name).width;
      (c as any).letterSpacing = '1.5px';
      c.font = `600 11px ${F_MONO}`; c.fillStyle = SCR.mid;
      c.fillText(card.stage.toUpperCase(), x + nw + 18, nBase);
      (c as any).letterSpacing = '0px';
      c.font = `400 16px ${F_HEAD}`; c.fillStyle = SCR.mid;
      let py = colsTop + (proofM ? proofM.pDy : 106);
      for (const line of wrapText(c, card.p, colW)) { c.fillText(line, x, py); py += pLh; }
      gridBottom = Math.max(gridBottom, py - pLh + 8 + 22);
    });
    // bottom row: exhibit note left, link right (justify-between, mt-10)
    const bBase = proofM?.exBase || gridBottom + 62 + 19;
    c.font = `400 15.5px ${F_HEAD}`; c.fillStyle = SCR.mid;
    let ey = bBase;
    const exLh = proofM ? proofM.exLh : 26;
    for (const line of wrapText(c, t.exhibit, proofM ? proofM.exW : 470)) { c.fillText(line, ML, ey); ey += exLh; }
    drawLink(c, 0, proofM?.linkBase || bBase, t.link, W - MR);
  }

  // ── §04 page — the objection, before the CTA ──
  function paintSec04(c: Ctx, W: number, H: number) {
    const t = copy.home.objection, MR = Math.round(W * .15);
    const { ML, hBase } = pageTop(c, W, MR, '04', t.label, 48);
    const hBottom = heading(c, ML, hBase, t.h, 48, W - ML - MR);
    c.font = `400 17px ${F_HEAD}`; c.fillStyle = SCR.mid;
    const proseW = c.measureText('0').width * 62;   // = DOM .prose-w (62ch)
    let py = hBottom + 24 + 20;                     // p mt-6 + half-leading + ascent
    for (const line of wrapText(c, t.p, proseW)) { c.fillText(line, ML, py); py += 28; }
  }

  // ── TOC page — the prospectus contents ──
  function paintToc(c: Ctx, W: number, H: number) {
    const ML = Math.round(W * .16), MR = ML;
    // The TOC page already reads as the album's front cover — 2026-08-28
    // gives it the same ghost-watermark + datum-cross furniture as the
    // other covers, at low cost (no twin, nothing to calibrate against).
    c.font = `300 ${Math.round(H * .5)}px ${F_HEAD}`;
    (c as any).letterSpacing = `${(H * .5 * -.05).toFixed(1)}px`;
    c.fillStyle = 'rgba(242,240,236,.07)';
    c.textAlign = 'right';
    c.fillText('M.', W - MR, H - 46);
    c.textAlign = 'left'; (c as any).letterSpacing = '0px';
    datumCross(c, ML + 8, H * .40, 10, .16);
    datumCross(c, W - MR - 8, 226, 10, .16);
    bar(c, ML, 74, 22, 22, 7, SCR.red);
    c.font = `700 26px ${F_HEAD}`; c.fillStyle = SCR.hi;
    c.fillText('Maquette.', ML + 36, 95);
    (c as any).letterSpacing = '2px';
    c.font = `600 12px ${F_MONO}`; c.fillStyle = SCR.mid;
    c.fillText('CONTENTS', ML, 190);
    (c as any).letterSpacing = '0px';
    c.strokeStyle = SCR.ln; c.lineWidth = 2;
    c.beginPath(); c.moveTo(ML + 92, 186); c.lineTo(W - MR, 186); c.stroke();
    const items: [string, string][] = [
      ['01', copy.home.build.label],
      ['02', copy.home.mech.label],
      ['03', copy.home.proof.label],
      ['04', copy.home.objection.label],
    ];
    let y = 260;
    for (const [idx, label] of items) {
      c.font = `500 15px ${F_MONO}`; c.fillStyle = SCR.red;
      c.fillText(idx, ML, y);
      c.font = `500 19px ${F_HEAD}`; c.fillStyle = SCR.body;
      c.fillText(label, ML + 44, y);
      const lw = c.measureText(label).width;
      leader(c, ML + 44 + lw + 18, W - MR, y - 5);
      y += 64;
    }
    c.font = `500 15px ${F_HEAD}`; c.fillStyle = SCR.red;
    c.fillText(copy.cta + '  →', ML, H - 84);
  }

  // ── ALBUM COVERS (2026-08-28) — the face each diving page shows while
  // far, parked-aside, or in the finale, so the floating scene reads as
  // an album of covers rather than blind blur smudges. Shared chrome +
  // one motif per section, in the /projects cover language (declutter-
  // cover.svg / gigtim-cover.svg): dark ground, sparse line-art in
  // ln/mid/body inks, ONE red accent (the plate index only). ──
  function paintCover(c: Ctx, W: number, H: number, idx: string, label: string, motif: (c: Ctx, W: number, H: number) => void) {
    const ML = Math.round(W * .15), MR = Math.round(W * .15), PT = Math.round(W * .04);
    // Ghost numeral watermark — first, under everything (echoes .sec-mark).
    const nSize = Math.round(H * .70);
    c.font = `300 ${nSize}px ${F_HEAD}`;
    (c as any).letterSpacing = `${(nSize * -.05).toFixed(1)}px`;
    c.fillStyle = 'rgba(242,240,236,.08)';
    c.textAlign = 'right';
    c.fillText(idx, W - MR, Math.round(H * .90));
    c.textAlign = 'left'; (c as any).letterSpacing = '0px';
    // Plate caption — same kicker() furniture, at the EXACT spot the real
    // section page draws its own (pageTop's PT+19), so this row never
    // shifts as the cover melts into the resolved page underneath it.
    kicker(c, ML, PT + 19, idx, label, W, MR);
    // Datum crosses — sparse, off the motif.
    datumCross(c, ML - 6, H * .80, 11, .16);
    datumCross(c, W - MR + 6, H * .26, 11, .16);
    motif(c, W, H);
  }

  // 01 — menu rows with dot leaders + category bars (echoes paintSec01).
  function motif01(c: Ctx, W: number, H: number) {
    const x0 = W * .15, xEnd = W * .62, rowH = (H * .46) / 4, y0 = H * .32;
    for (let i = 0; i < 4; i++) {
      const y = y0 + i * rowH + rowH * .5;
      const isLast = i === 3;
      const barW = W * (isLast ? .16 : .13 + (i % 2) * .04);
      bar(c, x0, y - 5, barW, 10, 5, isLast ? 'rgba(217,87,58,.85)' : `rgba(199,202,207,${(.45 + i * .1).toFixed(2)})`);
      c.strokeStyle = SCR.ln; c.lineWidth = 2.5; c.lineCap = 'round';
      c.setLineDash([0.1, 12]);
      c.beginPath(); c.moveTo(x0 + barW + 16, y); c.lineTo(xEnd, y); c.stroke();
      c.setLineDash([]); c.lineCap = 'butt';
      bar(c, xEnd + 14, y - 4, 22, 8, 4, 'rgba(139,143,148,.45)');
      if (i > 0) {
        c.strokeStyle = SCR.ln; c.lineWidth = 1;
        c.beginPath(); c.moveTo(x0, y0 + i * rowH); c.lineTo(xEnd + 36, y0 + i * rowH); c.stroke();
      }
    }
  }

  // 02 — blueprint title-block: framed plate, corner ticks, a nested
  // title cell, one dimension line above the frame.
  function motif02(c: Ctx, W: number, H: number) {
    const x0 = W * .15, y0 = H * .34, fw = W * .48, fh = H * .40;
    c.strokeStyle = SCR.ln; c.lineWidth = 2;
    c.strokeRect(x0, y0, fw, fh);
    const tk = 9;
    c.beginPath();
    for (const [cx, cy] of [[x0, y0], [x0 + fw, y0], [x0, y0 + fh], [x0 + fw, y0 + fh]] as [number, number][]) {
      c.moveTo(cx - tk, cy); c.lineTo(cx + tk, cy);
      c.moveTo(cx, cy - tk); c.lineTo(cx, cy + tk);
    }
    c.stroke();
    const dy = y0 - 22;
    c.strokeStyle = 'rgba(139,143,148,.55)'; c.lineWidth = 1.5;
    c.beginPath();
    c.moveTo(x0, dy); c.lineTo(x0 + fw, dy);
    c.moveTo(x0, dy - 6); c.lineTo(x0, dy + 6);
    c.moveTo(x0 + fw, dy - 6); c.lineTo(x0 + fw, dy + 6);
    c.stroke();
    const cw = fw * .42, ch = fh * .34, cx0 = x0 + fw - cw, cy0 = y0 + fh - ch;
    c.strokeStyle = SCR.ln; c.lineWidth = 1.5;
    c.strokeRect(cx0, cy0, cw, ch);
    c.beginPath(); c.moveTo(cx0, cy0 + ch * .5); c.lineTo(cx0 + cw, cy0 + ch * .5); c.stroke();
    bar(c, cx0 + 10, cy0 + 10, cw * .5, 7, 3.5, 'rgba(199,202,207,.6)');
    bar(c, cx0 + 10, cy0 + ch * .5 + 10, cw * .34, 6, 3, 'rgba(139,143,148,.5)');
  }

  // 03 — two mini plates echoing the /projects covers (tangle squiggles,
  // dot grid) + the honesty-stamp OUTLINE, dashed and NOT red — the red
  // stamp stays a single instance, drawn on the real §03 page only.
  function motif03(c: Ctx, W: number, H: number) {
    const s = Math.min(W, H) * .24, y0 = H * .32, gap = 26, x1 = W * .15, x2 = x1 + s + gap;
    c.strokeStyle = SCR.ln; c.lineWidth = 2;
    c.strokeRect(x1, y0, s, s);
    c.strokeStyle = 'rgba(139,143,148,.5)'; c.lineWidth = 2; c.lineCap = 'round';
    for (let i = 0; i < 3; i++) {
      const yy = y0 + s * (.28 + i * .22);
      c.beginPath();
      c.moveTo(x1 + s * .16, yy);
      c.quadraticCurveTo(x1 + s * .5, yy - s * .12, x1 + s * .84, yy);
      c.stroke();
    }
    c.lineCap = 'butt';
    c.strokeStyle = SCR.ln; c.lineWidth = 2;
    c.strokeRect(x2, y0, s, s);
    c.fillStyle = 'rgba(139,143,148,.55)';
    const gN = 4, pad = s * .18;
    for (let r = 0; r < gN; r++) for (let cc = 0; cc < gN; cc++) {
      const px = x2 + pad + (s - 2 * pad) * (cc / (gN - 1));
      const py = y0 + pad + (s - 2 * pad) * (r / (gN - 1));
      c.beginPath(); c.arc(px, py, 2.4, 0, Math.PI * 2); c.fill();
    }
    const stW = s * 1.7, stH = s * .5, stx = x1 + stW / 2, sty = y0 + s + stH / 2 + 26;
    c.save();
    c.translate(stx, sty); c.rotate(-.06);
    c.strokeStyle = SCR.ln; c.lineWidth = 2; c.setLineDash([5, 6]);
    c.beginPath(); c.roundRect(-stW / 2, -stH / 2, stW, stH, 8); c.stroke();
    c.setLineDash([]);
    c.restore();
  }

  // 04 — an empty, dashed exhibit frame: the case study that isn't there yet.
  function motif04(c: Ctx, W: number, H: number) {
    const x0 = W * .15, y0 = H * .32, fw = W * .46, fh = H * .40;
    c.strokeStyle = SCR.ln; c.lineWidth = 2;
    c.setLineDash([10, 10]);
    c.beginPath(); c.roundRect(x0, y0, fw, fh, 14); c.stroke();
    c.setLineDash([]);
    bar(c, x0 + fw * .12, y0 + fh * .36, fw * .5, 8, 4, 'rgba(139,143,148,.35)');
    bar(c, x0 + fw * .12, y0 + fh * .54, fw * .32, 8, 4, 'rgba(139,143,148,.28)');
    datumCross(c, x0 + fw * .80, y0 + fh * .76, 10, .3);
  }

  function paintCover01(c: Ctx, W: number, H: number) { paintCover(c, W, H, '01', copy.home.build.label, motif01); }
  function paintCover02(c: Ctx, W: number, H: number) { paintCover(c, W, H, '02', copy.home.mech.label, motif02); }
  function paintCover03(c: Ctx, W: number, H: number) { paintCover(c, W, H, '03', copy.home.proof.label, motif03); }
  function paintCover04(c: Ctx, W: number, H: number) { paintCover(c, W, H, '04', copy.home.objection.label, motif04); }

  // Rounded-corner shape/box — replaces BoxGeometry for every panel
  // silhouette, so the screens read as rounded cards, not slabs.
  function roundedShape(w: number, h: number, r: number) {
    const rr = Math.min(r, w / 2, h / 2);
    const hw = w / 2 - rr, hh = h / 2 - rr;
    const shape = new THREE.Shape();
    shape.moveTo(-hw, -h / 2);
    shape.lineTo(hw, -h / 2);
    shape.absarc(hw, -hh, rr, -Math.PI / 2, 0, false);
    shape.lineTo(w / 2, hh);
    shape.absarc(hw, hh, rr, 0, Math.PI / 2, false);
    shape.lineTo(-hw, h / 2);
    shape.absarc(-hw, hh, rr, Math.PI / 2, Math.PI, false);
    shape.lineTo(-w / 2, -hh);
    shape.absarc(-hw, -hh, rr, Math.PI, Math.PI * 1.5, false);
    return shape;
  }
  function roundedBox(w: number, h: number, depth: number, r: number, seg = 6) {
    const geo = new THREE.ExtrudeGeometry(roundedShape(w, h, r), { depth, bevelEnabled: false, curveSegments: seg });
    geo.translate(0, 0, -depth / 2);
    return geo;
  }

  // ═══════════════════════════════════════════════════════════════
  //  PANEL FACTORY
  // ═══════════════════════════════════════════════════════════════

  interface Panel {
    group: THREE.Group;
    bMat: THREE.MeshPhysicalMaterial;
    eMat: THREE.LineBasicMaterial;
    fMatB: THREE.MeshBasicMaterial;         // blurred page face (the approach state)
    fMatS: THREE.MeshBasicMaterial;         // sharp page face (the parked state)
    fMatC: THREE.MeshBasicMaterial | null;  // cover face (the far/aside/finale state)
    w: number; h: number; texW: number;
    seed: number;
  }

  // Painted page textures, one SHARP + one BLURRED per page. The blurred
  // variant is what floats in space — abstract, unreadable smudges of a
  // page — and the sharp one takes over only when the page parks at text
  // size. Per-panel px-per-unit so parked texture pixels map ≈1:1 to
  // screen pixels. Canvases + painters are kept so both variants repaint
  // once the real fonts finish loading.
  function mkTex(cnv: HTMLCanvasElement) {
    const tex = new THREE.CanvasTexture(cnv);
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.anisotropy = Math.min(8, R.capabilities.getMaxAnisotropy());
    return tex;
  }
  // bcnv/blur are optional: cover faces (screenTex(..., {blur:false}))
  // never park at 1:1 and never need a blurred variant, so they skip the
  // blur canvas entirely and paint at their own `res` (default RES).
  interface TexJob {
    cnv: HTMLCanvasElement; bcnv?: HTMLCanvasElement;
    paint: (c: Ctx, W: number, H: number) => void;
    sharp: THREE.CanvasTexture; blur?: THREE.CanvasTexture; blurPx: number;
    res: number;
  }
  // Textures are painted at 2× the logical resolution (painters keep
  // logical coordinates via setTransform), so the parked page stays crisp
  // on high-dpr screens and survives the slight park enlargement.
  const RES = 2;
  const texJobs: TexJob[] = [];
  function paintJob(j: TexJob) {
    const c = j.cnv.getContext('2d')!;
    c.setTransform(j.res, 0, 0, j.res, 0, 0);
    const W = j.cnv.width / j.res, H = j.cnv.height / j.res;
    c.fillStyle = SCR.bg; c.fillRect(0, 0, W, H);
    j.paint(c, W, H);
    j.sharp.needsUpdate = true;
    if (!j.bcnv || !j.blur) return;
    const bc = j.bcnv.getContext('2d')!;
    bc.setTransform(1, 0, 0, 1, 0, 0);
    bc.filter = 'none';
    bc.fillStyle = SCR.bg; bc.fillRect(0, 0, j.bcnv.width, j.bcnv.height);
    bc.filter = `blur(${j.blurPx * j.res}px)`;
    bc.drawImage(j.cnv, 0, 0);
    bc.filter = 'none';
    j.blur.needsUpdate = true;
  }
  function screenTex(w: number, h: number, ppu: number, paint: (c: Ctx, W: number, H: number) => void, opts?: { res?: number; blur?: boolean }) {
    const res = opts?.res ?? RES;
    const cnv = document.createElement('canvas');
    cnv.width = Math.round(w * ppu * res); cnv.height = Math.round(h * ppu * res);
    const wantBlur = opts?.blur !== false;
    const bcnv = wantBlur ? document.createElement('canvas') : undefined;
    if (bcnv) { bcnv.width = cnv.width; bcnv.height = cnv.height; }
    const job: TexJob = {
      cnv, bcnv, paint, sharp: mkTex(cnv), blur: bcnv ? mkTex(bcnv) : undefined,
      blurPx: Math.round(ppu / 11), res,
    };
    paintJob(job);
    texJobs.push(job);
    return job;
  }
  function repaintTextures() { for (const j of texJobs) paintJob(j); }

  // ShapeGeometry UVs are raw x/y coords — normalize to 0…1 so the
  // texture maps the rounded face exactly.
  function faceGeo(w: number, h: number, r: number) {
    const g = new THREE.ShapeGeometry(roundedShape(w, h, r), 8);
    const uv = g.attributes.uv;
    for (let i = 0; i < uv.count; i++) uv.setXY(i, (uv.getX(i) + w / 2) / w, (uv.getY(i) + h / 2) / h);
    return g;
  }

  function mkPanel(w: number, h: number, d: number, ppu: number, paint: (c: Ctx, W: number, H: number) => void, coverPaint?: (c: Ctx, W: number, H: number) => void): Panel {
    const g = new THREE.Group();
    const bMat = new THREE.MeshPhysicalMaterial({
      color: P.scr, roughness: .18, metalness: .7, clearcoat: .05,
      emissive: P.scr, emissiveIntensity: 0,
      transparent: true, opacity: 0, side: THREE.DoubleSide,
      polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1,
    });
    const eMat = new THREE.LineBasicMaterial({ color: P.ink, transparent: true, opacity: .75 });
    const rad = Math.min(w, h) * .07;
    const box = roundedBox(w, h, d, rad);
    g.add(new THREE.Mesh(box, bMat));
    g.add(new THREE.LineSegments(new THREE.EdgesGeometry(box), eMat));
    // Three page faces, cover under blur under sharp — un-tonemapped so
    // the palette is exact. Their opacities crossfade with scroll: cover
    // (far/aside/finale) → blur (approach) → sharp (parked).
    const job = screenTex(w, h, ppu, paint);
    const fGeo = faceGeo(w, h, rad);
    const fMatB = new THREE.MeshBasicMaterial({ map: job.blur, toneMapped: false, transparent: true, opacity: 0 });
    const fMatS = new THREE.MeshBasicMaterial({ map: job.sharp, toneMapped: false, transparent: true, opacity: 0 });
    const faceB = new THREE.Mesh(fGeo, fMatB);
    faceB.position.z = d / 2 + .008;
    const faceS = new THREE.Mesh(fGeo, fMatS);
    faceS.position.z = d / 2 + .012;
    g.add(faceB); g.add(faceS);
    // Cover face — no blur variant (never parks at 1:1, so half-res is
    // plenty), painted BELOW the blur face in the z-stack (it's the face
    // shown before the blur ever takes over).
    let fMatC: THREE.MeshBasicMaterial | null = null;
    if (coverPaint) {
      const cjob = screenTex(w, h, ppu, coverPaint, { res: 1, blur: false });
      fMatC = new THREE.MeshBasicMaterial({ map: cjob.sharp, toneMapped: false, transparent: true, opacity: 0 });
      const faceC = new THREE.Mesh(fGeo, fMatC);
      faceC.position.z = d / 2 + .004;
      g.add(faceC);
    }
    root.add(g);
    // texW is LOGICAL texture width (park sizing maps it ≈1:1 to screen px)
    return { group: g, bMat, eMat, fMatB, fMatS, fMatC, w, h, texW: Math.round(w * ppu), seed: Math.random() * 100 };
  }

  // ═══════════════════════════════════════════════════════════════
  //  CREATE PANELS
  // ═══════════════════════════════════════════════════════════════

  // Diving panels are 0.03·w shorter than their old 3:5-ish cuts — the
  // painted top padding dropped from 7% to 4% of W, and the geometry
  // sheds the same 3%·w so the parked card fits under the sticky header
  // at unchanged text scale.
  // Each diving panel also gets a coverPaint — its album-cover face,
  // shown while far/aside/finale (see paintCover above). pSide (TOC)
  // doesn't get one — it already reads as the album's front cover.
  // §02 and §04 are cut to their CONTENT height (2026-08-31: at 4.3/4.37
  // they parked with the whole lower half empty — an unfinished slide).
  // The painted layout is unchanged; only the box shrank onto it.
  const pMain = mkPanel(10, 5.7, .12, 128, paintSec01, paintCover01);
  const pAdm  = mkPanel(7, 3.4, .10, 160, paintSec02, paintCover02);
  const pSide = mkPanel(2.8, 6, .10, 192, paintToc);
  // §03's page is landscape (was a portrait "phone") — it parks over a
  // landscape section, and every floating object is a page now anyway.
  const pMobi = mkPanel(7.5, 4.37, .08, 160, paintSec03, paintCover03);
  const pObj  = mkPanel(7.5, 2.5, .08, 160, paintSec04, paintCover04);
  const panels = [pMain, pAdm, pSide, pMobi, pObj];

  // ═══════════════════════════════════════════════════════════════
  //  MEASURED TIMELINE — every section is a 100vh slide, every dive is
  //  centered on its own slide's measured center.
  //  Row: [scrollT, px,py,pz, rx,ry,rz, fillOpacity, edgeOpacity, uiOpacity, scale]
  //
  //  Scroll fractions hard-coded at one window size drift on every other
  //  one — both document height and each section's position depend on the
  //  viewport. So all timelines are generated from the real DOM (at boot
  //  and on every ScrollTrigger refresh): each slide's center is both the
  //  dive's peak AND the idle-settle magnet's rest point (they share the
  //  measured centers), and each dive's phases sit at fixed viewport-height
  //  fractions around that center — aligned on any screen by construction.
  //  Scroll → animation runs through a short scrub catch-up (0.25s).
  // ═══════════════════════════════════════════════════════════════

  type KF = number[];
  const kfMain: KF[] = [], kfAdm: KF[] = [], kfSide: KF[] = [], kfMobi: KF[] = [], kfObj: KF[] = [];
  const allKF = [kfMain, kfAdm, kfSide, kfMobi, kfObj];
  const camKF: [number, number, number, number][] = [];

  const secEls = ['s01', 's02', 's03', 's04', 'cta'].map((id) => document.getElementById(id));
  const innerEls = ['s01-inner', 's02-inner', 's03-inner', 's04-inner'].map((id) => document.getElementById(id));
  const pageEls = [0, 1, 2, 3].map((i) => document.getElementById(`mq-page-${i}`));
  // Reparent each section's real HTML into its fixed page twin. The
  // sections stay behind as empty 100vh scroll spacers (the timeline's
  // measurements don't change), and without JS the untouched server HTML
  // renders normally. The twin is shown only while its card is parked.
  innerEls.forEach((el, k) => {
    const shell = pageEls[k]?.querySelector('.mq-page-scale');
    if (el && shell) shell.appendChild(el);
  });

  // Poses: [px,py,pz, rx,ry,rz, scale]. One dive per content section —
  // each section's page flies in and PARKS at text size (parkPose, computed
  // from the live camera every frame — never full-screen). The TOC page
  // rides along and moves aside during §03's dive.
  // closeup = the blend's start pose: FAR and SMALL (behind the origin),
  // so the page's apparent size grows monotonically up to park size and
  // never overshoots it — the page must never look bigger than its text.
  const DIVES = [
    { panel: 0, closeup: [0, .30, -9, 0, .08, 0, .8],    angle: 1.35 },
    { panel: 1, closeup: [0, .40, -9, .02, -.06, 0, .9], angle: 1.55 },
    { panel: 3, closeup: [0, .20, -9, 0, -.05, 0, .9],   angle: 1.75 },
    { panel: 4, closeup: [0, .30, -9, 0, .06, 0, .9],    angle: 1.92 },
  ];
  const SCATTER = [
    [9, 3.5, -5, .12, .35, -.06, 1],
    [-8, 5.5, -6, -.08, .22, .04, 1],
    [-10, -2, 4, .05, -.25, -.08, 1],
    [11, 4, 7, .06, -.32, .10, .7],
    [-11, 1.5, 6, .08, .28, -.06, .7],
  ];
  const ASIDE = [
    [5.5, 1.5, -3.5, 0, .10, 0, 1],
    [-4.5, 3, -3.5, .08, .10, 0, 1],
    [-7.2, .5, 1.2, 0, .18, 0, 1],
    [7.8, -.4, 2.8, 0, -.22, 0, .6],
    [-8.6, 2.2, 2.4, 0, .24, 0, .55],
  ];
  const FINAL = [
    [0, .5, 0, 0, 0, 0, 1],
    [-1.5, 5.8, -3, .12, .08, 0, 1],
    [-7.2, .5, 1.2, 0, .18, 0, 1],
    [7.8, -.4, 2.8, 0, -.22, 0, .6],
    [-8.6, 2.2, 2.4, 0, .24, 0, .55],
  ];
  // ui (3rd value) raised sharply for hidden/dim (2026-08-28, second
  // pass): the renderer composites with alpha:true over the pale paper —
  // at the original .50/.45 the whole dark cover washed toward flat gray
  // against that paper (measured: at .50 the design is barely legible;
  // .85+ reads as a real dark object with visible bars/numeral/accent —
  // see the opacity sweep this was tuned against). solid/parked untouched.
  const OP = { hidden: [0, .60, .86], solid: [.92, .50, 1], dim: [.75, .30, .68] };
  const row = (t: number, pose: number[], op: number[]): KF =>
    [t, pose[0], pose[1], pose[2], pose[3], pose[4], pose[5], op[0], op[1], op[2], pose[6]];

  let pcs: number[] = [.2, .4, .6, .78];     // dive centers (progress space)
  let pcCta = .95, finStart = .84;           // CTA center / finale begins
  let holds: [number, number, number, number][] = [];
  let hudCuts: number[] = [.1, .3, .5, .7];
  // Idle-settle magnet state — refreshed by buildTimeline(), read by the
  // trigger's snapTo closure, so refresh/resize re-syncs the magnet free.
  let snapPts: number[] = [];                // rest points: top + plateau centers
  let snapPK = .04;                          // plateau half-width = dead zone
  // While the guided first pass drives the scroll, the idle-settle must
  // stand down — two magnets writing scroll fight each other (verified:
  // the tour's slow start goes scroll-event-silent for a beat, the snap
  // wakes, pulls back to the nearest rest point, and wins every frame).
  let tourOn = false;

  // interpKF needs strictly ascending scrollT — measured bounds could
  // collide on extreme viewports.
  function mono(rows: number[][]) {
    for (let i = 1; i < rows.length; i++)
      if (rows[i][0] <= rows[i - 1][0]) rows[i][0] = rows[i - 1][0] + .003;
  }

  // The parked card lives in the region BELOW the opaque sticky header —
  // centered on the full viewport its top slid under the header (cut).
  // Both parkPose and the DOM twins center on this region and cap the
  // card height to it (small breathing margin included).
  const headEl = document.querySelector('.site-head') as HTMLElement | null;
  let headH = 0;
  // Canvasul se estompează la zero pe măsură ce footerul intră în viewport
  // (2026-08-31): clusterul final plutea PESTE textul juridic din subsol.
  // footStart = progresul la care topul footerului atinge fundul viewportului.
  const footEl = document.querySelector('footer');
  let footStart = 1;
  const maxCardH = () => Math.max(innerHeight - headH - 24, 200);

  // Size each DOM page twin with the SAME formula as parkPose, in CSS px:
  // the twin sits exactly on the parked card. Runs on every refresh.
  function layoutPages() {
    headH = headEl?.offsetHeight ?? 0;
    for (let k = 0; k < pageEls.length; k++) {
      const pg = pageEls[k]; if (!pg) continue;
      const pnl = panels[DIVES[k].panel];
      let wPx = Math.min(pnl.texW * 1.12, .94 * innerWidth);
      if (wPx * pnl.h / pnl.w > maxCardH()) wPx = maxCardH() * pnl.w / pnl.h;
      const hPx = wPx * pnl.h / pnl.w;
      pg.style.width = `${wPx.toFixed(2)}px`;
      pg.style.height = `${hPx.toFixed(2)}px`;
      // centered in the visible region below the header, like parkPose
      pg.style.top = `calc(50% + ${(headH / 2).toFixed(1)}px)`;
      pg.style.borderRadius = `${Math.round(Math.min(pnl.w, pnl.h) * .07 / pnl.w * wPx)}px`;
      pg.style.setProperty('--pgs', (wPx / pnl.texW).toFixed(5));
      const sc = pg.querySelector('.mq-page-scale') as HTMLElement;
      sc.style.width = `${pnl.texW}px`;
      // logical-px padding (CSS % would resolve against the parent's
      // scaled width). Sides 15% = the painters' ML/MR exactly — the
      // twin's content box must equal the painted content box (70% of
      // texW) or the park crossfade rewraps the heading and shifts rows.
      sc.style.padding = `${Math.round(pnl.texW * .01)}px ${Math.round(pnl.texW * .15)}px ${Math.round(pnl.texW * .03)}px`;
      // Vertical self-calibration — the old fixed top padding assumed the
      // twin's line boxes above the kicker fill 3%·W; they don't, and the
      // parked text sat ~38 logical px high (user: "moves a little bit
      // up"). The painters put the first heading baseline at
      // PT + 25 + 42 + ASC(hSize); measure the twin's REAL baseline (an
      // inline-block probe's bottom = the text baseline) and absorb the
      // difference into padding-top. Runs per refresh, never per frame;
      // fonts.ready triggers a refresh, so late fonts recalibrate too.
      const hEl = sc.querySelector('.t-h2');
      if (hEl) {
        const hSize = parseFloat(pg.style.getPropertyValue('--pg-h')) || 48;
        const target = Math.round(pnl.texW * .04) + 25 + 42 + Math.round(hSize * .91);
        const probe = document.createElement('span');
        probe.style.cssText = 'display:inline-block;width:0;height:0;padding:0;margin:0;border:0;';
        hEl.insertBefore(probe, hEl.firstChild);
        const measured = (probe.getBoundingClientRect().bottom - sc.getBoundingClientRect().top) / (wPx / pnl.texW);
        probe.remove();
        sc.style.paddingTop = `${Math.round(pnl.texW * .01 + target - measured)}px`;
      }
      // §03 only: measure the twin's honesty stamp — box center/size,
      // rotation, border, and each line's font + baseline — in LOGICAL px
      // (rects divided by the twin scale), and hand it to paintSec03. Must
      // run AFTER the padding-top calibration above, which shifts the
      // stamp's flow position. The rotation is suspended for the reads
      // (rotate is paint-only, so clearing it causes no reflow); the
      // inline-block probe trick is the same as the heading's. If the
      // geometry changed, the §03 texture repaints from the new values —
      // one stamp, drawn twice identically, instead of two stamps.
      if (k === 2) {
        const s = wPx / pnl.texW;
        const scRect = sc.getBoundingClientRect();
        const probeBase = (el: Element) => {
          const pr = document.createElement('span');
          pr.style.cssText = 'display:inline-block;width:0;height:0;padding:0;margin:0;border:0;';
          el.insertBefore(pr, el.firstChild);
          const b = (pr.getBoundingClientRect().bottom - scRect.top) / s;
          pr.remove();
          return b;
        };
        const lhOf = (el: Element) => {
          const cs = getComputedStyle(el);
          const lh = parseFloat(cs.lineHeight);
          return isNaN(lh) ? (parseFloat(cs.fontSize) || 16) * 1.5 : lh;
        };
        const st = sc.querySelector('.stamp') as HTMLElement | null;
        if (st) {
          const cs = getComputedStyle(st);
          const rm = /^(-?[\d.]+)(deg|rad|grad|turn)/.exec(cs.rotate);
          const rot = !rm ? 0 : parseFloat(rm[1]) *
            ({ deg: Math.PI / 180, rad: 1, grad: Math.PI / 200, turn: Math.PI * 2 })[rm[2] as 'deg' | 'rad' | 'grad' | 'turn'];
          const prevRot = st.style.rotate;
          st.style.rotate = '0deg';
          const r = st.getBoundingClientRect();
          const lines = Array.from(st.children).map((ch) => {
            const lcs = getComputedStyle(ch);
            return {
              size: parseFloat(lcs.fontSize) || 10,
              wt: parseInt(lcs.fontWeight) || 600,
              ls: parseFloat(lcs.letterSpacing) || 0,
              base: probeBase(ch),
            };
          });
          st.style.rotate = prevRot;
          stampM = {
            cx: (r.left + r.width / 2 - scRect.left) / s,
            cy: (r.top + r.height / 2 - scRect.top) / s,
            w: r.width / s, h: r.height / s,
            bw: parseFloat(cs.borderTopWidth) || 0,
            r: parseFloat(cs.borderTopLeftRadius) || 0,
            rot, lines,
          };
        }
        // Product columns + bottom row: same treatment. The first article
        // anchors both grid columns (they're top-aligned twins); the
        // baselines and line-heights come from the real boxes, not from
        // the painter's old +22+46/26px approximations (those sat the
        // names ~10px and the bottom row ~20px below the twin).
        const art = sc.querySelector('article');
        const p1 = art?.querySelector('p');
        if (art && p1) {
          const rowTop = (art.getBoundingClientRect().top - scRect.top) / s;
          const h4 = art.querySelector('.t-h3');
          const lnk = sc.querySelector('a.lnk');
          const exP = lnk?.parentElement?.querySelector('p');
          proofM = {
            rowTop,
            nameDy: (h4 ? probeBase(h4) : rowTop + 68) - rowTop,
            pDy: probeBase(p1) - rowTop,
            pLh: lhOf(p1),
            exBase: exP ? probeBase(exP) : 0,
            exLh: exP ? lhOf(exP) : 26,
            exW: exP ? exP.getBoundingClientRect().width / s : 470,
            linkBase: lnk ? probeBase(lnk) : 0,
          };
        }
        const sig = JSON.stringify([stampM, proofM]);
        if (sig !== stampSig) {
          stampSig = sig;
          const j = texJobs.find((j) => j.paint === paintSec03);
          if (j) paintJob(j);
        }
      }
    }
  }

  function buildTimeline() {
    layoutPages();
    const max = Math.max(document.documentElement.scrollHeight - innerHeight, 1);
    footStart = footEl
      ? Math.min(Math.max(((footEl as HTMLElement).offsetTop - innerHeight) / max, .5), .999)
      : 1;
    const centers = secEls.map((el, i) => el
      ? Math.min(Math.max((el.offsetTop + el.offsetHeight / 2 - innerHeight / 2) / max, 0), 1)
      : .2 + i * .19);
    pcs = centers.slice(0, 4);
    pcCta = centers[4];
    const F = innerHeight / max;             // one viewport-height, in progress units
    // The page parks at TEXT size (never full screen). Park blend runs
    // [pc-C → pc-PK], holds parked across [pc-PK → pc+PK]. The plateau is
    // WIDE (±0.22F — the brand.md figure; ~44% of the line between centers
    // is settled) so free scroll grazes it easily, and the phases tile the
    // half-window exactly: PK + (C−PK) + (A−C) = A = half the slide spacing,
    // so adjacent dive windows abut with no overlap.
    const A = .50 * F;                       // approach begins / aside reached
    const C = .36 * F;                       // close-up reached / park blend starts
    const PK = .22 * F;                      // parked at text size

    holds   = pcs.map((pc) => [pc - C, pc - PK, pc + PK, pc + C] as [number, number, number, number]);
    snapPK  = PK;
    snapPts = [0, ...pcs, pcCta, 1];         // 0 = hero top, 1 = footer bottom
    finStart = pcs[3] + A;                   // the finale begins after §04's page departs
    hudCuts = [pcs[0] - A, (pcs[0] + pcs[1]) / 2, (pcs[1] + pcs[2]) / 2, (pcs[2] + pcs[3]) / 2, (pcs[3] + pcCta) / 2];

    DIVES.forEach((d, k) => {
      const pc = pcs[k], i = d.panel, kf = allKF[i];
      kf.length = 0;
      kf.push(
        row(0, SCATTER[i], OP.hidden),
        row(pc - A, SCATTER[i], OP.hidden),
        row(pc - C, d.closeup, OP.solid),
        row(pc + C, d.closeup, OP.solid),
        row(pc + A, ASIDE[i], OP.dim),
        row(pcCta - .6 * F, ASIDE[i], OP.dim),
        row(pcCta, FINAL[i], OP.solid),
        row(1, FINAL[i], OP.solid),
      );
      mono(kf);
    });

    // Sidebar — rides along §03's approach, parks aside during the dive.
    {
      const pc = pcs[2];
      kfSide.length = 0;
      kfSide.push(
        row(0, SCATTER[2], OP.hidden),
        row(pc - A, SCATTER[2], OP.hidden),
        row(pc - C, [-2.5, 0, 1.5, 0, .15, 0, 1], OP.solid),
        row(pc - PK, ASIDE[2], OP.dim),
        row(pcCta, FINAL[2], OP.solid),
        row(1, FINAL[2], OP.solid),
      );
      mono(kfSide);
    }

    // Camera: one continuous path — dolly into each dive, pull back to a
    // single mid-point between consecutive dives (never a full return to
    // orbit, which would collide with the next dive's approach).
    camKF.length = 0;
    camKF.push([0, 40, 22, 0], [Math.max(.02, pcs[0] - A, .02), 28, 12, DIVES[0].angle - .35]);
    DIVES.forEach((d, k) => {
      const pc = pcs[k];
      camKF.push([pc - PK, 7, 2.5, d.angle], [pc + PK, 7, 2.5, d.angle]);
      // Mid-point pull-back kept soft (r=11, was 16): the brief pause before
      // the idle-settle glide should read as a composed wide shot, not an
      // abandoned orbit.
      if (k < DIVES.length - 1)
        camKF.push([(pc + pcs[k + 1]) / 2, 11, 4, (d.angle + DIVES[k + 1].angle) / 2]);
    });
    camKF.push([pcs[3] + A, 30, 14, DIVES[3].angle + .08]);
    camKF.push([pcCta, 36, 15, 1.95], [1, 34, 14, 2.0]);
    mono(camKF);
  }
  buildTimeline();

  // ═══════════════════════════════════════════════════════════════
  //  CONNECTIONS (draw themselves in Phase 4)
  // ═══════════════════════════════════════════════════════════════

  interface Conn { curve: THREE.CatmullRomCurve3; line: THREE.Line; mat: THREE.LineBasicMaterial; nPts: number; }
  const conns: Conn[] = [];
  const CONN_PTS = 60;

  function mkConn(pts: THREE.Vector3[]): Conn {
    const curve = new THREE.CatmullRomCurve3(pts);
    const mat = new THREE.LineBasicMaterial({ color: P.red, transparent: true, opacity: 0 });
    const geom = new THREE.BufferGeometry().setFromPoints(curve.getPoints(CONN_PTS));
    const line = new THREE.Line(geom, mat);
    line.geometry.setDrawRange(0, 0);
    root.add(line);
    return { curve, line, mat, nPts: CONN_PTS + 1 };
  }

  conns.push(mkConn([new THREE.Vector3(-5,.5,.06), new THREE.Vector3(-5.8,1.5,.8), new THREE.Vector3(-7.2,.5,1.2)]));
  conns.push(mkConn([new THREE.Vector3(5,.5,.06), new THREE.Vector3(6.5,-.5,1.8), new THREE.Vector3(7.8,-.4,2.8)]));
  conns.push(mkConn([new THREE.Vector3(0,3.5,0), new THREE.Vector3(-.5,4.5,-1.2), new THREE.Vector3(-1.5,5.8,-3)]));
  conns.push(mkConn([new THREE.Vector3(-7.2,3.5,1.2), new THREE.Vector3(-5.5,5,-0.5), new THREE.Vector3(-1.5,5.8,-3)]));

  // ─── Data particles ───
  interface Ptcl { mesh: THREE.Mesh; ci: number; ph: number; spd: number; }
  const ptcls: Ptcl[] = [];
  const ptclGeo = new THREE.SphereGeometry(.1, 8, 8);
  for (let ci = 0; ci < conns.length; ci++) {
    for (let j = 0; j < 3; j++) {
      const m = new THREE.Mesh(
        ptclGeo,
        new THREE.MeshStandardMaterial({ color: P.red, emissive: P.scrRed, emissiveIntensity: 0, transparent: true, opacity: 0, roughness: .2, metalness: .3 })
      );
      root.add(m);
      ptcls.push({ mesh: m, ci, ph: j / 3, spd: .12 + Math.random() * .06 });
    }
  }

  // ─── Grid ───
  const gm1 = new THREE.LineBasicMaterial({ color: P.red, transparent: true, opacity: .2 });
  const gm2 = new THREE.LineBasicMaterial({ color: P.hl, transparent: true, opacity: .12 });
  const grid = new THREE.GridHelper(40, 40, gm1.color, gm2.color);
  // @ts-ignore
  grid.material = [gm1, gm2];
  grid.position.y = -3.8;
  root.add(grid);

  // ─── Datum crosses ───
  const NC = 30;
  const ca = new Float32Array(NC * 18);
  for (let i = 0; i < NC; i++) {
    const cx=(Math.random()-.5)*50, cy=(Math.random()-.5)*28+4, cz=(Math.random()-.5)*50, sz=.25+Math.random()*.2, o=i*18;
    ca[o]=cx-sz; ca[o+1]=cy; ca[o+2]=cz;  ca[o+3]=cx+sz; ca[o+4]=cy; ca[o+5]=cz;
    ca[o+6]=cx; ca[o+7]=cy-sz; ca[o+8]=cz; ca[o+9]=cx; ca[o+10]=cy+sz; ca[o+11]=cz;
    ca[o+12]=cx; ca[o+13]=cy; ca[o+14]=cz-sz; ca[o+15]=cx; ca[o+16]=cy; ca[o+17]=cz+sz;
  }
  const cg = new THREE.BufferGeometry(); cg.setAttribute('position', new THREE.BufferAttribute(ca, 3));
  const cm = new THREE.LineBasicMaterial({ color: P.mid, transparent: true, opacity: .15 });
  const crosses = new THREE.LineSegments(cg, cm);
  S.add(crosses);

  // ═══════════════════════════════════════════════════════════════
  //  INPUT — ScrollTrigger scrubs a proxy tween; sp is the eased progress.
  //  Snap reinstated 2026-08-27 as an IDLE-SETTLE (the 2026-08-25 removal
  //  cited a "click" — see the contract at the trigger config below for how
  //  this version avoids it). Still no DOM portal: the card itself is the
  //  background at each dive's peak.
  // ═══════════════════════════════════════════════════════════════

  let sp = 0, tmx = 0, tmy = 0, smx = 0, smy = 0;
  const hs = document.getElementById('mq-hs'), hp = document.getElementById('mq-hp'), hb = document.getElementById('mq-hud');
  const vig = document.getElementById('mq-vig');

  // Set whenever something outside the scroll loop invalidates the frame
  // (resize clears the GL buffer, refresh moves keyframes, fonts repaint
  // textures) — otherwise the demand-rendering skip would show a stale or
  // blank canvas until the next scroll.
  let needsFrame = true;
  const onMM = (e: MouseEvent) => { tmx = (e.clientX/innerWidth-.5)*2; tmy = (e.clientY/innerHeight-.5)*2; };
  addEventListener('mousemove', onMM, { passive: true });
  function onR() { cam.aspect = innerWidth/innerHeight; cam.updateProjectionMatrix(); R.setSize(innerWidth,innerHeight); needsFrame = true; }
  addEventListener('resize', onR);

  // Free scroll stays untouched DURING every gesture; the wide plateau
  // (±0.22F, restored 2026-08-27) handles grazing, and the idle-settle
  // magnet below handles stops mid-transit. Scrub is a short catch-up
  // (0.25s — tightened 2026-08-28 from 0.35, "the animation part doesn't
  // feel responsive"), so discrete wheel steps read as one continuous motion instead
  // of stepped jumps. A numeric scrub only smooths a linked animation (a
  // standalone trigger reports raw progress), so the trigger scrubs a proxy
  // tween and the render loop reads the eased value.
  //
  // IDLE-SETTLE contract (reinstated 2026-08-27 — none of the 2026-08-25
  // failure modes): reacts almost instantly (0.05s after the LAST scroll
  // event — trackpad/touch inertia keeps resetting the clock, so no
  // gesture is ever caught mid-flight) but glides GENTLY (0.5–0.85s
  // power3.out: full speed at once, long soft landing — user feedback:
  // "fast reaction → small animation", the old inOut's slow start read as
  // staying put and its middle read as a lurch) · ScrollTrigger kills the
  // snap tween on any new input — the user always wins · dead zone on the
  // plateau: anyone already parked (twin on) is never nudged · the HERO
  // TOP and the FOOTER BOTTOM are rest points with NO dead zone — every
  // stop resolves somewhere composed; there is no free zone left, because
  // both leftovers looked broken (half-clipped hero; red block half
  // off-screen over the footer) · non-directional nearest-center: small
  // nudges relax back like a magnet. Targets are the measured centers,
  // read via closure, so every refresh re-syncs them. Plan B if built-in
  // cancellation ever feels fighty: hand-rolled 'scroll' debounce →
  // gsap.to(window,{scrollTo, autoKill:true}) with explicit input-kill
  // listeners (ScrollToPlugin is vendored, unimported).
  const prox = { p: 0 };
  const tw = gsap.to(prox, {
    p: 1,
    ease: 'none',
    scrollTrigger: {
      start: 0,
      end: () => ScrollTrigger.maxScroll(window),
      scrub: 0.25,
      onRefresh: () => { buildTimeline(); needsFrame = true; },
      snap: {
        snapTo: (value: number) => {
          if (tourOn || !snapPts.length) return value;   // guided pass owns the scroll
          let nearest = snapPts[0];
          for (const p of snapPts)
            if (Math.abs(p - value) < Math.abs(nearest - value)) nearest = p;
          // Plateau dead zone for the section/CTA centers only. The two
          // endpoints (hero top, footer bottom) have none: they must rest
          // at their exact edge — anything in between (half-clipped hero,
          // red block half off-screen above the footer) looks broken.
          if (nearest > 0 && nearest < 1 && Math.abs(nearest - value) <= snapPK) return value;
          return nearest;
        },
        delay: 0.05,
        duration: { min: 0.5, max: 0.85 },
        ease: 'power3.out',
        directional: false,
        inertia: false,  // judge from where the user STOPPED, not a velocity
                         // projection — with inertia on, a fast flick hands
                         // snapTo a far-projected value and the settle
                         // overshoots whole sections
      },
    },
  });
  // Layout settles late (fonts) — remeasure everything once they're in,
  // and repaint the card pages with the real faces.
  (document as any).fonts?.ready?.then(() => { repaintTextures(); ScrollTrigger.refresh(); needsFrame = true; });

  // ═══════════════════════════════════════════════════════════════
  //  GUIDED PASS — explicit user decision (2026-08-27), overriding the
  //  scrolljacking guidance. It runs on EVERY page load (2026-08-28 —
  //  the once-per-visitor localStorage flag was removed at the user's
  //  request: "always when I open the website, have the animation"; a
  //  reload or a new tab replays the tour). Scroll input is a slide deck:
  //  ONE gesture (wheel notch, swipe, arrow/PgDn/Space) = ONE full section
  //  transition on a fast-attack/flat-cruise blend (tourEase below), with
  //  the frozen plateau spans EXCISED from the tween (see step()) so every
  //  animated frame shows motion — extra input during the transition is
  //  ignored, no matter how hard they scroll. Backward gestures play the previous section at the
  //  same pace. Two escapes are kept from the a11y guidance: nav LINKS
  //  stay clickable (only scroll input is intercepted) and the KEYBOARD
  //  works as gestures. Reaching the CTA ends the tour FOR THIS PAGE VIEW
  //  — from there, free scroll + idle-settle (the behavior above) until
  //  the next load. Reduced motion never gets here (boot() returns long
  //  before this). Scrollbar dragging bypasses the lock — known limit,
  //  shared by every slide-deck implementation.
  {
    tourOn = true;                               // idle-settle stands down for the pass
    const COOL = 250;                            // ms between gestures
    // Fallback cruise ease (in-out) — used only if arc sampling degenerates.
    const tourEase = (t: number) => {
      const u = 1 - t;
      return .10 * (1 - u * u) + .90 * (.5 - .5 * Math.cos(Math.PI * t));
    };
    // ARC-LENGTH PACING (2026-08-28, sixth round: "the card that barely
    // moves is slow, the card that comes a long way — §03 from its
    // top-right scatter to center — is very fast and harsh"). No fixed
    // ease can equalize APPARENT speed: each card travels a different
    // on-screen distance per scroll unit, and it differs per section.
    // So before each step we SAMPLE the real scene math — the same
    // camera, timeline and park-blend formulas the render loop uses —
    // at 48 points across the live span, accumulate opacity-weighted
    // screen-px motion of all five cards, and invert that curve: the
    // tween spends time proportional to VISIBLE motion. A sine in-out on
    // the arc gives soft take-off and landing, so perceived speed is one
    // smooth bell no matter what the choreography does. Sampling mutates
    // the live `cam` between frames — harmless, render() re-poses it from
    // scroll on every rAF. (~250 pose evaluations per gesture, <1ms.)
    const _aV = new THREE.Vector3();
    const _pb = [0, 0, 0, 0, 0];
    const arcEase = (a: number, b: number): ((t: number) => number) | null => {
      const N = 48;
      const cum = new Float64Array(N + 1);
      const lx = new Float64Array(panels.length), ly = new Float64Array(panels.length);
      const lw = new Float64Array(panels.length);
      for (let k = 0; k <= N; k++) {
        const s = a + (b - a) * (k / N);
        let dh = 0;
        _pb[0] = _pb[1] = _pb[2] = _pb[3] = _pb[4] = 0;
        for (let d = 0; d < holds.length; d++) {
          const h = trap(s, holds[d][0], holds[d][1], holds[d][2], holds[d][3]);
          if (h > dh) dh = h;
          _pb[DIVES[d].panel] = h;
        }
        const [cR, cH, cA] = interpCam(camKF, s);
        cam.position.set(Math.cos(cA) * cR, cH, Math.sin(cA) * cR);
        cam.lookAt(0, 2 - dh * 1.5, 0);
        cam.updateMatrixWorld();
        // Per-panel screen deltas, split into OBJECT motion (relative to
        // the weighted-mean displacement) and global camera PAN. A pan
        // moves every projected point at once — the lookAt target drops
        // 1.5 units during every park blend — but perceptually a
        // full-frame pan reads far calmer than an object crossing the
        // frame, so it counts at 35%. Without the split, the pan made the
        // blend zones swallow ~70% of the arc and the tween crawled there.
        const dxs = [0, 0, 0, 0, 0], dys = [0, 0, 0, 0, 0], ws = [0, 0, 0, 0, 0];
        let gx = 0, gy = 0, wSum = 0;
        for (let i = 0; i < panels.length; i++) {
          const v = interpKF(allKF[i], s);
          let x = v[0], y = v[1], z = v[2];
          const cT = _pb[i];
          // Perceptual weight: opacity softened (.25 floor) — a
          // semi-transparent card sweeping the frame is still very
          // visible (§03's fastest approach happens at ui≈.22, and pure
          // opacity weighting starved it of time); the render damp
          // (cards fading while another parks) still zeroes it out.
          const w = (.25 + .75 * Math.max(v[6], v[8])) * (cT > 0 ? 1 : 1 - dh);
          if (cT > 0) {
            parkPose(panels[i]);
            const e = eio(cT);
            x += (_covPos.x - x) * e; y += (_covPos.y - y) * e; z += (_covPos.z - z) * e;
          }
          _aV.set(x, y, z).project(cam);
          const sx = _aV.x * innerWidth * .5, sy = _aV.y * innerHeight * .5;
          if (k > 0) {
            const wgt = Math.min(w, lw[i]);
            dxs[i] = sx - lx[i]; dys[i] = sy - ly[i]; ws[i] = wgt;
            gx += wgt * dxs[i]; gy += wgt * dys[i]; wSum += wgt;
          }
          lx[i] = sx; ly[i] = sy; lw[i] = w;
        }
        let stepPx = 0;
        if (k > 0 && wSum > 0) {
          gx /= wSum; gy /= wSum;
          // Fit the common similarity motion — translation g (camera pan)
          // + radial zoom λ about the weighted centroid (camera dolly) —
          // and count it at 30%: optic-flow pan/zoom moves every point a
          // lot but reads calm. The RESIDUAL is true object-vs-frame
          // motion (a card sweeping the scene) and counts in full.
          let cx = 0, cy = 0;   // centroid of the PREVIOUS sample's positions
          for (let i = 0; i < panels.length; i++) { cx += ws[i] * (lx[i] - dxs[i]); cy += ws[i] * (ly[i] - dys[i]); }
          cx /= wSum; cy /= wSum;
          let num = 0, den = 0;
          for (let i = 0; i < panels.length; i++) {
            const rx = lx[i] - dxs[i] - cx, ry = ly[i] - dys[i] - cy;   // position at k-1, centered
            num += ws[i] * (rx * (dxs[i] - gx) + ry * (dys[i] - gy));
            den += ws[i] * (rx * rx + ry * ry);
          }
          const lam = den > 1e-6 ? num / den : 0;
          let avgR = 0;
          for (let i = 0; i < panels.length; i++) {
            const rx = lx[i] - dxs[i] - cx, ry = ly[i] - dys[i] - cy;
            avgR += ws[i] * Math.hypot(rx, ry);
            const ex = dxs[i] - gx - lam * rx, ey = dys[i] - gy - lam * ry;
            stepPx += ws[i] * Math.min(Math.hypot(ex, ey), 300);
          }
          avgR /= wSum;
          stepPx += .3 * Math.min(Math.hypot(gx, gy) + Math.abs(lam) * avgR, 300) * wSum;
        }
        // small floor per step: the warp never creates zero-speed holes
        cum[k] = k ? cum[k - 1] + stepPx + .75 : 0;
      }
      const total = cum[N];
      (window as any).__arc = { a, b, cum: Array.from(cum) };  // DEBUG — remove
      if (!(total > 1)) return null;
      return (t: number) => {
        const target = (.5 - .5 * Math.cos(Math.PI * t)) * total;
        let lo = 0;
        while (lo < N && cum[lo + 1] < target) lo++;
        const seg = cum[lo + 1] - cum[lo] || 1e-9;
        return Math.min(1, (lo + (target - cum[lo]) / seg) / N);
      };
    };
    const gTargets = () => snapPts.slice(0, -1); // [0, pcs…, pcCta] — the tour ends at the CTA
    const gp = { y: 0 };
    let tourTw: ReturnType<typeof gsap.to> | null = null;
    let coolUntil = 0;
    let done = false;
    const unhook = () => {
      tourOn = false;                        // re-arm the idle-settle magnet
      removeEventListener('wheel', onTourWheel, { capture: true });
      removeEventListener('touchstart', onTourTS, { capture: true });
      removeEventListener('touchmove', onTourTM, { capture: true });
      removeEventListener('keydown', onTourKey, { capture: true });
    };
    const finish = () => {
      if (done) return;
      done = true;      // free scroll + idle-settle from here until the next load
      unhook();
    };
    const step = (dir: 1 | -1) => {
      const now = performance.now();
      if (tourTw?.isActive() || now < coolUntil) return;
      const max = Math.max(ScrollTrigger.maxScroll(window), 1);
      const pts = gTargets();
      if (!pts.length) return;
      const p = scrollY / max;
      let i = 0;
      for (let k = 1; k < pts.length; k++)
        if (Math.abs(pts[k] - p) < Math.abs(pts[i] - p)) i = k;
      const j = Math.min(Math.max(i + dir, 0), pts.length - 1);
      if (j === i) return;
      // PLATEAU EXCISION (2026-08-28, "remove those frames where the card
      // just stays"): around every parked section, ±PK of scroll renders
      // pixel-identical frames by construction (camera flat, card pinned
      // by parkPose, all other tracks constant; only the HUD % differs).
      // The tween therefore animates ONLY the live span between plateau
      // edges. Departure keeps a fixed 0.15s micro-dash across its frozen
      // span — exactly the DOM twin's fade-out window, so sharp text never
      // ghosts over a moving card. Arrival is a plain teleport in
      // onComplete: the ease's soft landing falls on the park-dock motion
      // (h→1 completes at the plateau edge), never on frozen frames — the
      // old fixed-duration tween spent ~1.1s of its tail crawling the
      // arrival plateau. Duration scales with the live distance so the
      // approved cruise pace (~0.31·F/s) holds for long and short steps
      // alike. Hero top and CTA have no card plateau → no dash/teleport
      // on that side.
      const from = pts[i], to = pts[j];
      const sgn = to > from ? 1 : -1;
      const isSec = (k: number) => k > 0 && k < pts.length - 1;  // pc1…pc4
      const start = isSec(i) ? from + sgn * snapPK : from;
      const end = isSec(j) ? to - sgn * snapPK : to;
      const F = innerHeight / max;
      const live = Math.abs(end - start);
      const dur = Math.min(2.8, Math.max(1.6, live / (.29 * F)));
      const DASH = isSec(i) ? .15 : 0;
      const T = DASH + dur, tp = T > 0 ? DASH / T : 0;
      const dashFrac = Math.abs(start - from) / Math.max(Math.abs(end - from), 1e-9);
      const cruise = arcEase(start, end) ?? tourEase;
      const ez = DASH
        ? (t: number) => (t < tp ? dashFrac * (t / tp)
                                 : dashFrac + (1 - dashFrac) * cruise((t - tp) / (1 - tp)))
        : cruise;
      gp.y = scrollY;
      tourTw = gsap.to(gp, {
        y: end * max,
        duration: T,
        ease: ez,
        onUpdate: () => scrollTo(0, gp.y),
        onComplete: () => {
          gp.y = to * max;
          scrollTo(0, gp.y);                     // arrival teleport — identical frames
          coolUntil = performance.now() + COOL;
          if (j === pts.length - 1) finish();    // CTA reached — tour over
        },
      });
    };
    // A gentle trackpad swipe opens with deltas of 1–3 per event — a fixed
    // per-event threshold swallowed the whole gesture ("I scroll a bit and
    // it stays in place"). Accumulate instead: a few units of intent,
    // in one direction, within a beat, are enough to commit a step.
    let acc = 0, accT = 0;
    const onTourWheel = (e: WheelEvent) => {
      e.preventDefault();
      const now = performance.now();
      if (tourTw?.isActive() || now < coolUntil) { acc = 0; return; }
      if (now - accT > 400 || (acc !== 0 && Math.sign(e.deltaY) !== Math.sign(acc))) acc = 0;
      accT = now;
      acc += e.deltaY;
      if (Math.abs(acc) > 6) { const d = acc > 0 ? 1 : -1; acc = 0; step(d as 1 | -1); }
    };
    let tourTy = 0;
    const onTourTS = (e: TouchEvent) => { tourTy = e.touches[0].clientY; };
    const onTourTM = (e: TouchEvent) => {
      e.preventDefault();
      const dy = tourTy - e.touches[0].clientY;
      if (Math.abs(dy) > 30) { tourTy = e.touches[0].clientY; step(dy > 0 ? 1 : -1); }
    };
    const onTourKey = (e: KeyboardEvent) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      const fwd = ['ArrowDown', 'PageDown', 'End'].includes(e.key) || (e.key === ' ' && !e.shiftKey);
      const bwd = ['ArrowUp', 'PageUp', 'Home'].includes(e.key) || (e.key === ' ' && e.shiftKey);
      if (!fwd && !bwd) return;
      e.preventDefault();
      step(fwd ? 1 : -1);
    };
    addEventListener('wheel', onTourWheel, { passive: false, capture: true });
    addEventListener('touchstart', onTourTS, { passive: true, capture: true });
    addEventListener('touchmove', onTourTM, { passive: false, capture: true });
    addEventListener('keydown', onTourKey, { capture: true });
    document.addEventListener('astro:before-swap', () => { tourTw?.kill(); unhook(); }, { once: true });
  }

  cv.style.opacity = '1'; if (hb) hb.style.opacity = '.5';

  // ═══════════════════════════════════════════════════════════════
  //  INTERPOLATION
  // ═══════════════════════════════════════════════════════════════

  const cl = (v: number) => Math.max(0, Math.min(1, v));
  const eio = (t: number) => t < .5 ? 4*t*t*t : 1 - (-2*t+2)**3/2;
  const eo = (t: number) => 1 - (1 - t) ** 3;

  // Trapezoid: 0 → 1 ramp [a,b], flat 1 [b,c], 1 → 0 ramp [c,d]. Drives every
  // induced stop — the parallax damp and the portal crossfade share this.
  function trap(v: number, a: number, b: number, c: number, d: number) {
    if (v <= a || v >= d) return 0;
    if (v < b) return (v - a) / (b - a);
    if (v <= c) return 1;
    return 1 - (v - c) / (d - c);
  }

  // Interpolate a keyframe array at scroll position t into a preallocated
  // buffer (no per-frame slice/map allocations — GC churn drops frames).
  const kfOut = new Float64Array(10);
  function interpKF(kfs: number[][], t: number): Float64Array {
    let i = 0;
    while (i < kfs.length - 1 && kfs[i + 1][0] <= t) i++;
    if (i >= kfs.length - 1) {
      const l = kfs[kfs.length - 1];
      for (let j = 1; j < l.length; j++) kfOut[j - 1] = l[j];
      return kfOut;
    }
    const a = kfs[i], b = kfs[i + 1];
    const e = eio(cl((t - a[0]) / (b[0] - a[0])));
    for (let j = 1; j < a.length; j++) kfOut[j - 1] = a[j] + (b[j] - a[j]) * e;
    return kfOut;
  }

  function interpCam(kfs: [number,number,number,number][], t: number): [number,number,number] {
    let i = 0;
    while (i < kfs.length - 1 && kfs[i + 1][0] <= t) i++;
    if (i >= kfs.length - 1) return [kfs[kfs.length-1][1], kfs[kfs.length-1][2], kfs[kfs.length-1][3]];
    const a = kfs[i], b = kfs[i + 1];
    const e = eio(cl((t - a[0]) / (b[0] - a[0])));
    return [a[1]+(b[1]-a[1])*e, a[2]+(b[2]-a[2])*e, a[3]+(b[3]-a[3])*e];
  }

  // ═══════════════════════════════════════════════════════════════
  //  RENDER LOOP
  // ═══════════════════════════════════════════════════════════════

  // Ceas manual (THREE.Clock e deprecat în r165+; nu merită importul
  // THREE.Timer pentru un delta și un elapsed).
  let prevMs = performance.now();
  let fid: number;
  let lastHud = -1, lastPct = -1, lastSp = -1, idleTick = 0;
  const lastPg = [false, false, false, false];
  const C_MID = new THREE.Color(P.mid), C_INK = new THREE.Color(P.ink);
  const tmpC = new THREE.Color();
  const parkBy = [0, 0, 0, 0, 0];            // per-panel park blend, 0…1

  // PARK pose, computed from the LIVE camera: the page floats at PARK_DIST
  // in front of it, dead-parallel, scaled so texture pixels map ≈1:1 to
  // screen pixels (its text arrives at real display size) — and centered
  // on the region BELOW the sticky header, clamped to fit it: paper stays
  // visible around the parked page and the header never cuts its top.
  const _dir = new THREE.Vector3(), _covPos = new THREE.Vector3(), _covQ = new THREE.Quaternion();
  const _up = new THREE.Vector3();
  const PARK_DIST = 5;
  let _covS = 1;
  function parkPose(pnl: Panel) {
    cam.getWorldDirection(_dir);
    _covPos.copy(cam.position).addScaledVector(_dir, PARK_DIST);
    _covQ.copy(cam.quaternion);
    const vhW = 2 * PARK_DIST * Math.tan(THREE.MathUtils.degToRad(cam.fov / 2));
    const vwW = vhW * cam.aspect;
    const pxW = vhW / innerHeight;           // world units per CSS px at PARK_DIST
    // shift down by half the header height — center of the VISIBLE region
    _up.set(0, 1, 0).applyQuaternion(cam.quaternion);
    _covPos.addScaledVector(_up, -headH / 2 * pxW);
    // ×1.12: the page parks a touch closer/larger than exact 1:1 (user
    // feedback 2026-08-26) — the 2× texture keeps it crisp regardless.
    const fracW = Math.min((pnl.texW * 1.12) / innerWidth, .94);
    let s = fracW * vwW / pnl.w;
    const maxH = maxCardH() * pxW;
    if (s * pnl.h > maxH) s = maxH / pnl.h;
    _covS = s;
  }

  function render() {
    fid = requestAnimationFrame(render);
    const nowMs = performance.now();
    const dt = Math.min((nowMs - prevMs) / 1000, .1);
    prevMs = nowMs;
    const t = nowMs / 1000;

    // Eased scroll progress from the scrubbed proxy tween — GSAP catches
    // the playhead up to the scrollbar over ~0.25s, so wheel steps blend.
    sp = prox.p;

    // Footer fade: 1 cât timp footerul e sub viewport, 0 la fundul paginii
    // — scena întreagă se retrage din spatele textului juridic.
    const ff = 1 - eio(cl((sp - footStart) / Math.max(1 - footStart, .001)));

    // Only the mouse parallax keeps its own easing (it isn't scroll).
    smx += (tmx - smx) * 0.04;
    smy += (tmy - smy) * 0.04;

    // Dive hold, 0 → 1 → 0 across whichever section's window sp is in.
    // Damps mouse parallax (the page goes rock-still), biases the camera
    // head-on and drives each panel's park blend. The HTML text needs no
    // per-frame work at all — the page texture IS the text.
    let diveHold = 0;
    for (let k = 0; k < holds.length; k++) {
      const h = trap(sp, holds[k][0], holds[k][1], holds[k][2], holds[k][3]);
      if (h > diveHold) diveHold = h;
      parkBy[DIVES[k].panel] = h;
      // DOM page twin: on only while the card is exactly parked (the
      // trapezoid's flat plateau) — both layers static, so the crossfade
      // is a pure focus shift and links/selection work on real HTML.
      const on = h >= .999;
      if (on !== lastPg[k]) { lastPg[k] = on; pageEls[k]?.classList.toggle('on', on); }
    }

    // ── Camera (pure function of scroll — rigid) ──
    const [cR, cH, cAoff] = interpCam(camKF, sp);
    const parX = smx * .12 * (1 - diveHold);
    const parY = smy * (1 - diveHold);
    const cA = cAoff + parX;
    cam.position.set(Math.cos(cA) * cR, cH + parY * -2, Math.sin(cA) * cR);
    cam.lookAt(0, 2 - diveHold * 1.5, 0);

    // ── Panels — authored pose from the timeline, then blended toward the
    // computed cover pose by the section's cover value. The camera is
    // already posed above, so the cover pose tracks it exactly. ──
    for (let i = 0; i < panels.length; i++) {
      const pnl = panels[i];
      const v = interpKF(allKF[i], sp);
      // v = [px, py, pz, rx, ry, rz, fill, edge, ui, scale]
      pnl.group.position.set(v[0], v[1], v[2]);
      pnl.group.rotation.set(v[3], v[4], v[5]);
      const s0 = v[9] || 1;
      pnl.group.scale.setScalar(s0);

      const cT = parkBy[i];
      if (cT > 0) {
        parkPose(pnl);
        const e = eio(cT);
        pnl.group.position.lerp(_covPos, e);
        pnl.group.quaternion.slerp(_covQ, e);
        pnl.group.scale.setScalar(s0 + (_covS - s0) * e);
      }

      const fillT = v[6];
      // Pages not diving fade OUT while another page is parked, so the
      // parked page and its text own the screen alone.
      const damp = cT > 0 ? 1 : 1 - diveHold;
      // The "text appearing" animation: blur resolves to crisp as the
      // page parks, and blurs back as it leaves — the page carries its
      // text away instead of the text scrolling off.
      const resolve = eo(cl((cT - .55) / .35));
      // The "album opens" animation (2026-08-28): the cover melts into
      // the blur face early in the approach (done at cT=.45, well before
      // resolve starts at .55 — cover and sharp text never coexist).
      // Both canvases share the same opaque SCR.bg ground, so the blend
      // can't flash. cT=1 (parked): melt=1, resolve=1 → sharp alone,
      // bit-identical to the pre-cover crossfade. No fMatC (pSide/TOC):
      // melt is hard-coded 1, and the formulas below reduce exactly to
      // the original two-face math.
      const melt = pnl.fMatC ? eo(cl((cT - .12) / .33)) : 1;
      const faceVis = v[8] * damp * ff;
      pnl.bMat.opacity = fillT * damp * ff;
      pnl.eMat.opacity = v[7] * damp * ff;
      if (pnl.fMatC) pnl.fMatC.opacity = faceVis * (1 - melt);
      pnl.fMatB.opacity = faceVis * melt * (1 - resolve);
      pnl.fMatS.opacity = faceVis * resolve;

      // Edge color shifts to subtler when filled
      pnl.eMat.color.copy(tmpC.copy(C_INK).lerp(C_MID, fillT * .5));

      // Subtle emissive glow when fully filled (color preset in mkPanel)
      pnl.bMat.emissiveIntensity = fillT > .8 ? (fillT - .8) * .6 : 0;
    }

    // ── Convergence: connections draw between §04 and the CTA ──
    const connP = cl((sp - finStart) / Math.max(pcCta - finStart, .001));
    const connDraw = eo(connP);
    for (const cn of conns) {
      cn.mat.opacity = connP * .65 * ff;
      cn.line.geometry.setDrawRange(0, Math.floor(cn.nPts * connDraw));
    }

    // ── Data particles (appear after connections) ──
    const ptclVis = cl((sp - (finStart + pcCta) / 2) / Math.max((1 - finStart) / 2, .001));
    for (const pt of ptcls) {
      const m = pt.mesh.material as THREE.MeshStandardMaterial;
      m.opacity = eo(ptclVis) * .85 * ff;
      m.emissiveIntensity = ptclVis * 3 * ff;
      if (ptclVis > 0) {
        pt.ph = (pt.ph + dt * pt.spd) % 1;
        pt.mesh.position.copy(conns[pt.ci].curve.getPointAt(pt.ph));
        pt.mesh.scale.setScalar(1 + Math.sin(t * 6 + pt.ph * 10) * .25);
      }
    }

    // ── Grid ──
    gm1.opacity = (.15 + sp * .15) * ff;
    gm2.opacity = (.08 + sp * .10) * ff;

    // ── Red point light (grows in Phase 4) ──
    rPt.intensity = connP * 5;
    rPt.distance = 25 + connP * 30;
    if (sp > .9) { rPt.intensity = 5 + (Math.sin((sp - .9) * 80) * .5 + .5) * 4; }
    rPt.intensity *= ff;

    // ── Datum crosses — scroll-driven, so an idle page is truly static;
    // faded during dives (some sit closer to the camera than the card) ──
    crosses.rotation.y = -sp * 1.2;
    cm.opacity = .15 * (1 - diveHold) * ff;

    // ── HUD + paper vignette (fade while a card covers the screen) ──
    if (hb) {
      const ho = Math.round(.5 * (1 - diveHold) * 100) / 100;
      if (ho !== lastHud) {
        lastHud = ho;
        hb.style.opacity = String(ho);
        if (vig) vig.style.opacity = String(Math.round((1 - diveHold) * 100) / 100);
      }
    }
    if (hs && hp) {
      const pct = Math.round(sp * 100);
      if (pct !== lastPct) {
        lastPct = pct;
        hp.textContent = `${pct} %`;
        if (sp < hudCuts[0])      hs.textContent = 'PROSPECTUS // 5 PAGES';
        else if (sp < hudCuts[1]) hs.textContent = 'SECTION 01 // SERVICES';
        else if (sp < hudCuts[2]) hs.textContent = 'SECTION 02 // BLUEPRINT';
        else if (sp < hudCuts[3]) hs.textContent = 'SECTION 03 // PROOF';
        else if (sp < hudCuts[4]) hs.textContent = 'SECTION 04 // OBJECTION';
        else                      hs.textContent = 'SYSTEM // CONNECTED';
      }
    }

    // Demand rendering: when the scene is genuinely static (no scrub
    // catch-up in flight, parallax settled, no particles, nothing external
    // invalidated the frame), drop to a ~2fps heartbeat instead of a full
    // stop — a page that presents zero frames stalls screenshot/capture
    // pipelines and similar tooling.
    const moving = needsFrame || sp !== lastSp
      || Math.abs(tmx - smx) > .002 || Math.abs(tmy - smy) > .002
      || ptclVis > 0;
    if (moving || ++idleTick >= 30) { R.render(S, cam); needsFrame = false; idleTick = 0; }
    lastSp = sp;
  }

  render();

  // Cleanup
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(fid);
    tw.scrollTrigger?.kill();
    tw.kill();
    removeEventListener('resize', onR);
    removeEventListener('mousemove', onMM);
    R.dispose();
    (cv as any).__mq = false;
  }, { once: true });
}

boot();
document.addEventListener('astro:page-load', boot);
</script>
