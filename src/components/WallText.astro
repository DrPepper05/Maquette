---
/** Text pictat direct pe perete — fără placă, fără chenar. */
interface Props { label: string; items: readonly (readonly [string, string, string])[]; col: number; span: number; off?: number; row?: number; }
const { label, items, col, span, off = 0, row } = Astro.props;
const style = [`--col:${col}`, `--span:${span}`, `--off:${off}px`, row ? `--row:${row}` : ''].filter(Boolean).join(';');
---
<div class="walltext" style={style}>
  <p class="lbl">{label}</p>
  <dl class="mt-4.5">
    {items.map(([dt, strong, rest]) => (
      <>
        <dt>{dt}</dt>
        <dd>{strong && <b>{strong}</b>}{strong && ' '}{rest}</dd>
      </>
    ))}
  </dl>
</div>
