---
import Base from '../../layouts/Base.astro';
import SectionHead from '../SectionHead.astro';
import Hall from '../Hall.astro';
import Plate from '../Plate.astro';
import WallText from '../WallText.astro';
import BeforeAfter from '../screens/BeforeAfter.astro';
import { copy, routes, type Lang } from '../../i18n/copy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const c = t.home;
const g = t.gallery;
const firstQ = t.blueprint.questions[0];
---
<Base lang={lang} route="home" title={c.title} desc={c.desc}>

  <!-- ═══ 1 · HERO — în 5 secunde: ce vinzi și cui ═══════════════
       Fără cifră. 450 pe homepage ancorează tot studioul jos. -->
  <section class="wrap pt-32 md:pt-36 pb-4" data-seq>
    <p class="lbl lbl-red" data-seq-i>{c.eyebrow}</p>
    <h1 class="t-display mt-5" style="max-width: 13ch" data-seq-i>{c.h1}</h1>
    <p class="t-serif mt-5" data-seq-i>{c.tagline}</p>
    <p class="mt-7 lede prose-w" data-seq-i>{c.lede}</p>
    <div class="flex flex-wrap items-center gap-6 mt-10" data-seq-i>
      <a class="btn btn-red" href={routes.blueprint[lang]}>{t.cta}</a>
      <a class="lnk" href={routes.how[lang]}>{t.ctaGhost}</a>
    </div>
  </section>

  <!-- ═══ 2 · PROBLEMA — numește durerea înainte de ofertă ═══════ -->
  <section class="wrap pt-24 md:pt-28 rise">
    <SectionHead title={c.thesisLabel} />
    <h2 class="t-h2 mt-8" style="max-width: 21ch">{c.thesisH}</h2>
    <p class="mt-5 prose-w text-[17px]" style="color: var(--mid)">{c.thesisP}</p>
  </section>

  <!-- ═══ 3 · MECANISMUL — „și ce faci în privința asta?" ════════ -->
  <section class="wrap pt-24 rise">
    <SectionHead title={c.mechLabel} aside={c.dim} />
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] mt-8">
      <div>
        <h2 class="t-h2" style="max-width: 19ch">{c.mechH}</h2>
        <p class="mt-5 text-[17px] prose-w" style="color: var(--mid)">{c.mechP}</p>
        <a class="lnk mt-7 inline-flex" href={routes.blueprint[lang]}>{c.mechCta}</a>
      </div>
      <dl class="grid gap-0 content-start">
        {c.mechPoints.map(([h, p]) => (
          <div class="py-4" style="border-top: 1px solid var(--edge)">
            <dt class="lbl" style="color: var(--hi)">{h}</dt>
            <dd class="m-0 mt-2 text-[15px]" style="color: var(--mid)">{p}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ═══ 4 · CE CONSTRUIM — triaj de oferte, cât mai sus ════════════════ -->
  <section class="wrap pt-24 rise">
    <SectionHead title={c.servLabel} aside={c.servAside} />
    <div class="grid gap-5 md:grid-cols-3 mt-8">
      {c.services.map(([label, h, p, priceLbl, price], i) => (
        <a href={i === 0 ? routes.blueprint[lang] : routes.services[lang]}
           class="card p-7 no-underline flex flex-col">
          <span class="lbl">{label}</span>
          <h3 class="t-h3 mt-4">{h}</h3>
          <p class="mt-3 text-[15px] flex-1" style="color: var(--mid)">{p}</p>
          <div class="mt-6 pt-4 flex items-baseline justify-between gap-3" style="border-top: 1px solid var(--edge)">
            <span class="lbl">{priceLbl}</span>
            {price && <strong class="tabular text-[16px]">{price}</strong>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ 5 · PROCESUL — Blueprint-ul e o poartă, nu o fundătură ══ -->
  <section class="wrap pt-24 md:pt-28 rise">
    <SectionHead title={c.howLabel} aside={c.howAside} />
    <ol class="grid gap-0 md:grid-cols-3 md:gap-8 mt-8 list-none p-0 m-0">
      {c.steps.map(([n, h, p]) => (
        <li class="pt-5" style="border-top: 1px solid var(--edge)">
          <span class="lbl lbl-red tabular">{n}</span>
          <h3 class="t-h3 mt-3">{h}</h3>
          <p class="mt-2.5 text-[15px]" style="color: var(--mid)">{p}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ═══ 6 · DOVADA — diagnosticul, arătat ════════════════════════
       Vine DUPĂ mecanism, niciodată înainte: o secțiune vizual densă
       pusă înainte ca vizitatorul să fi stabilit scopul paginii îi
       strică exact înțelegerea scopului. -->
  <div class="mt-24 md:mt-28">
    <Hall label={c.thesisLabel} title={c.diagH} lede={c.diagP} note={c.proofNote}>
      <Plate index="01" col={1} span={9} off={0} speed={1.03}
             title={g.plates.flow.title} kind={g.kinds.demo} tech={g.plates.flow.tech}>
        <BeforeAfter lang={lang} />
      </Plate>

      <WallText label={g.keyLabel} items={g.key} col={10} span={3} off={40} />
    </Hall>
  </div>

  <!-- ═══ 7 · OBIECȚIA — una singură, fix înainte de CTA ═════════ -->
  <section class="wrap pt-24 rise">
    <SectionHead title={c.objLabel} />
    <div class="card p-7 md:p-10 mt-8">
      <h2 class="t-h3" style="max-width: 34ch">{firstQ[0]}</h2>
      <p class="mt-4 prose-w text-[16px]" style="color: var(--mid)">{firstQ[1]}</p>
    </div>
  </section>

  <!-- ═══ 8 · CTA FINAL ═════════════════════════════════════════ -->
  <section class="wrap pt-24 rise">
    <h2 class="t-h2" style="max-width: 18ch">{c.endH}</h2>
    <p class="mt-5 prose-w text-[17px]" style="color: var(--mid)">{c.endP}</p>
    <a class="btn btn-red mt-9" href={routes.contact[lang]}>{t.cta}</a>
  </section>

</Base>
