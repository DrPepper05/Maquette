---
import Base from '../../layouts/Base.astro';
import SectionHead from '../SectionHead.astro';
import { copy, routes, type Lang } from '../../i18n/copy';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang]; const c = t.how;
---
<Base lang={lang} route="how" title={c.title} desc={c.desc}>
  <section class="wrap pt-32 md:pt-36 pb-4">
    <p class="lbl lbl-red">{c.eyebrow}</p>
    <h1 class="t-display mt-4">{c.h1}</h1>
    <p class="mt-6 prose-w text-[17px]" style="color: var(--mid)">{c.lede}</p>
  </section>

  <section class="wrap pt-16 grid gap-4 md:grid-cols-2">
    {c.blocks.map(([h, p]) => (
      <div class="card p-7">
        <h2 class="t-h3">{h}</h2>
        <p class="mt-3 mb-0 text-[15px]" style="color: var(--mid)">{p}</p>
      </div>
    ))}
  </section>

  <section class="wrap pt-20">
    <SectionHead title={c.sizeH} />
    <p class="prose-w text-[17px]" style="color: var(--mid)">{c.sizeP}</p>
    <a class="btn mt-10 inline-block" href={routes.contact[lang]}>{t.cta}</a>
  </section>
</Base>
