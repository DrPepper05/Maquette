---
/** Mini-carduri ambientale — carduri mici, GOALE, plutind în hârtia din
 *  jurul cardului mare al secțiunii: ecoul paginilor blurate de pe
 *  homepage. Pur decorative (aria-hidden, fără pointer events), pur CSS
 *  (mini-bob în global.css; reduced-motion le oprește). Layout-uri
 *  DETERMINISTE — trei presete, alese cu `n` — ca SSR-ul să fie stabil.
 *  Părintele trebuie să fie .sec (position: relative). */
interface Props { n?: number }
const { n = 0 } = Astro.props;

const PRESETS: { style: string; cls: string }[][] = [
  [
    { style: 'top:-36px; left:-64px; width:150px; height:100px; rotate:-6deg; --mb-dur:9s; --mb-delay:0s;', cls: '' },
    { style: 'top:16%; right:-72px; width:110px; height:150px; rotate:5deg; --mb-dur:11s; --mb-delay:1.2s;', cls: 'lite' },
    { style: 'bottom:-28px; left:10%; width:190px; height:118px; rotate:3deg; --mb-dur:10s; --mb-delay:2.1s;', cls: 'md-only' },
  ],
  [
    { style: 'top:-30px; right:-58px; width:170px; height:110px; rotate:5deg; --mb-dur:10s; --mb-delay:.6s;', cls: '' },
    { style: 'top:38%; left:-80px; width:120px; height:160px; rotate:-4deg; --mb-dur:12s; --mb-delay:0s;', cls: 'lite md-only' },
    { style: 'bottom:-34px; right:14%; width:150px; height:96px; rotate:-3deg; --mb-dur:9.5s; --mb-delay:1.8s;', cls: '' },
  ],
  [
    { style: 'top:6%; left:-70px; width:130px; height:170px; rotate:4deg; --mb-dur:11s; --mb-delay:1.5s;', cls: '' },
    { style: 'top:-40px; right:8%; width:180px; height:110px; rotate:-5deg; --mb-dur:9s; --mb-delay:.4s;', cls: 'lite md-only' },
    { style: 'bottom:-26px; right:-60px; width:120px; height:140px; rotate:6deg; --mb-dur:10.5s; --mb-delay:2.6s;', cls: '' },
  ],
];
const set = PRESETS[((n % PRESETS.length) + PRESETS.length) % PRESETS.length];
---
<div aria-hidden="true">
  {set.map((m) => <div class={`mini-card ${m.cls}`} style={m.style}></div>)}
</div>
