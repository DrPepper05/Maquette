---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import AmbientCards from '../components/AmbientCards.astro';
import Figure from '../components/Figure.astro';
import BlueprintDoc from '../components/screens/BlueprintDoc.astro';
import { copy, routes } from '../copy';
const t = copy.blueprint;
---
<Base route="blueprint" title={t.title} desc={t.desc}>

  <!-- ── Hero + fișa produsului — mecanismul prețului, nu cifra (2026-08-25) ── -->
  <section class="wrap" style="padding-top: clamp(64px, 8vw, 110px)">
    <p class="lbl">{t.eyebrow}</p>
    <h1 class="t-display mt-6 max-w-[18ch]" style="font-size: clamp(38px, 5.6vw, 76px)">{t.h1}</h1>
    <p class="lede prose-w mt-7">{t.lede}</p>

    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-x-10 mt-14 border-t" style="border-color: var(--hairline)">
      {t.facts.map(([dt, dd]) => (
        <div class="pt-4">
          <dt class="lbl">{dt}</dt>
          <dd class="m-0 mt-1.5 font-semibold text-[16.5px]">{dd}</dd>
        </div>
      ))}
    </dl>
    </div>
  </section>

  <!-- ── 01 · Durerea ── -->
  <section class="wrap sec rise">
    <SectionHead index="01" title={t.pain.label} />
    <h2 class="t-h2 max-w-[22ch]">{t.pain.h}</h2>
    <p class="mt-6 prose-w" style="color: var(--mid)">{t.pain.p}</p>
  </section>

  <!-- ── 02 · Ce primești — cinci livrabile ── -->
  <section class="wrap sec rise">
    <SectionHead index="02" title={t.get.label} />
    <AmbientCards n={0} />
    <div class="float-card card-page-lite" data-tilt="2">
    <ol class="m-0 p-0 list-none grid">
      {t.get.deliverables.map(([h, p], i) => (
        <li class="row-line grid gap-x-10 gap-y-1 md:grid-cols-[44px_240px_1fr]">
          <span class="lbl tabular pt-0.5">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="t-h3 !text-[18px]">{h}</h3>
          <p class="text-[16px]" style="color: var(--mid)">{p}</p>
        </li>
      ))}
    </ol>
    </div>
  </section>

  <!-- ── 03 · Procesul — pași, nu zile (2026-08-25) ── -->
  <section class="wrap sec rise">
    <SectionHead index="03" title={t.process.label} />
    <div class="float-card card-page-lite" data-tilt="2">
    <dl class="m-0 grid">
      {t.process.rows.map(([d, p]) => (
        <div class="row-line grid gap-x-10 gap-y-1 md:grid-cols-[120px_1fr]">
          <dt class="lbl tabular pt-0.5">{d}</dt>
          <dd class="m-0 text-[16.5px]">{p}</dd>
        </div>
      ))}
    </dl>
    </div>
  </section>

  <!-- ── 04 · Garanția + reversarea riscului, lipite de buton (tiparul Stark) ──
       Singurul bloc roșu de pe pagină. Fără cifră (2026-08-25). -->
  <section class="block-red sec rise">
    <div class="wrap">
      <SectionHead index="04" title={t.guarantee.label} />
      <h2 class="t-h2 max-w-[22ch]">{t.guarantee.h}</h2>
      <p class="mt-5 text-[16.5px] font-semibold max-w-[52ch]">{t.guarantee.p}</p>
      <div class="row-line mt-8 max-w-[52ch]" style="border-color: var(--hairline)">
        <h3 class="t-h3 !text-[18px]">{t.guarantee.keepH}</h3>
        <p class="mt-2 text-[16px]" style="color: var(--mid)">{t.guarantee.keepP}</p>
      </div>
      <a href={routes.contact} class="btn btn-paper mt-9">{copy.cta}</a>
    </div>
  </section>

  <!-- ── 05 · Livrabilul-mostră — „ăsta e ce primești" ── -->
  <section class="wrap sec rise">
    <SectionHead index="05" title={t.sample.label} />
    <AmbientCards n={1} />
    <div class="float-card card-page-lite" data-tilt="2">
    <h2 class="t-h2">{t.sample.h}</h2>
    <div class="mt-10 max-w-[720px]">
      <Figure index="01" title={t.sample.fig.title} kind="deliverable" tech={t.sample.fig.tech}>
        <BlueprintDoc />
      </Figure>
    </div>
    </div>
  </section>

  <!-- ── 06 · Pentru cine e / nu e ── -->
  <section class="wrap sec rise">
    <SectionHead index="06" title={t.fit.label} />
    <div class="float-card card-page-lite" data-tilt="2">
    <div class="grid gap-x-14 gap-y-8 md:grid-cols-2">
      <ul class="m-0 p-0 list-none grid content-start">
        {t.fit.yes.map((li) => (
          <li class="row-line text-[16px] pl-7 relative">
            <span class="absolute left-0 top-[19px] lbl" aria-hidden="true">—</span>{li}
          </li>
        ))}
      </ul>
      <ul class="m-0 p-0 list-none grid content-start">
        {t.fit.no.map((li) => (
          <li class="row-line text-[16px] pl-7 relative" style="color: var(--mid)">
            <span class="absolute left-0 top-[19px] lbl" aria-hidden="true">×</span>{li}
          </li>
        ))}
      </ul>
    </div>
    </div>
  </section>

  <!-- ── 07 · Toate cele șapte întrebări ── -->
  <section class="wrap sec rise">
    <SectionHead index="07" title={t.q.label} />
    <AmbientCards n={2} />
    <div class="float-card card-page-lite" data-tilt="2">
    <div class="grid max-w-[74ch]">
      {t.q.items.map(([q, a]) => (
        <div class="row-line">
          <h3 class="t-h3 !text-[18px]">{q}</h3>
          <p class="mt-2 text-[16px]" style="color: var(--mid)">{a}</p>
        </div>
      ))}
    </div>
    </div>
  </section>

  <!-- ── CTA final ── -->
  <section class="wrap sec rise">
    <h2 class="t-h2 max-w-[20ch]">{t.end.h}</h2>
    <a href={routes.contact} class="btn mt-9">{copy.cta}</a>
  </section>

</Base>
