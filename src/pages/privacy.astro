---
import Base from '../layouts/Base.astro';
import { copy } from '../copy';
const t = copy.privacy;
---
<Base route="privacy" title={t.title} desc={t.desc}>

  <section class="wrap" style="padding-top: clamp(64px, 8vw, 110px)">
    <h1 class="t-display" style="font-size: clamp(38px, 5.6vw, 76px)">{t.h1}</h1>
    <p class="lbl mt-5">{t.updated}</p>

    <div class="grid max-w-[70ch] mt-14">
      {t.sections.map(([h, p]) => (
        <div class="row-line rise">
          <h2 class="t-h3 !text-[17px]">{h}</h2>
          <p class="mt-2 text-[16px]" style="color: var(--mid)">{p}</p>
        </div>
      ))}
    </div>
  </section>

</Base>
