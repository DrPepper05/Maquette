---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import AmbientCards from '../components/AmbientCards.astro';
import ExhibitActions from '../components/ExhibitActions.astro';
import DeclutterApp from '../components/screens/DeclutterApp.astro';
import GigTimDoc from '../components/screens/GigTimDoc.astro';
import { copy } from '../copy';
const t = copy.projects;
const email = 'contact@maquette.ro';
---
<Base route="projects" title={t.title} desc={t.desc}>

  <section class="wrap" style="padding-top: clamp(64px, 8vw, 110px)">
    <p class="lbl">{t.eyebrow}</p>
    <h1 class="t-display mt-6 max-w-[16ch]" style="font-size: clamp(38px, 5.6vw, 76px)">{t.h1}</h1>
    <p class="lede prose-w mt-7">{t.lede}</p>
  </section>

  <!-- ── Exponatele — unul pe ecran, cu figură mare și acțiuni.
       Id-urile sunt ex-*, niciodată s01…cta (alea trezesc canvas-ul).
       Eticheta de stadiu trebuie să rămână adevărată. ── -->
  {t.exhibits.map((p, i) => (
    <section class="wrap sec rise exhibit" id={`ex-${p.slug}`}>
      <SectionHead index={String(i + 1).padStart(2, '0')} title="Exhibit" />
      <AmbientCards n={i} />

      <!-- cardul-album PĂTRAT, o singură vedere (2026-08-28): fața e doar
           coperta — ilustrația SVG, numele, eticheta de stadiu și butonul
           „View more" (proeminent, hârtie pe întuneric). TOT textul stă pe
           SPATELE cardului: teza, secțiunile lungi și acțiunile — „View
           more" îl întoarce 180° pe Y. Rotația stă pe .flip-inner,
           legănarea/tilt-ul pe wrapper — niciodată același element. -->
      <div class="flip float-card" data-tilt="1.5" data-flip>
        <div class="flip-inner">
          <article class="card-page album flip-front">
            <div class="album-cover">
              {p.cover ? (
                <img class="cover-img" src={p.cover} alt={`${p.name} — cover`} loading="lazy" />
              ) : (
                <div class="cover-live" inert>
                  {p.slug === 'declutter' ? <DeclutterApp /> : <GigTimDoc />}
                </div>
              )}
              <span class="lbl album-fig">FIG. {String(i + 1).padStart(2, '0')} · {p.fig.title} — {p.fig.tech}</span>
              <div class="album-scrim" aria-hidden="true"></div>
              <div class="album-title">
                <div>
                  <h2 class="t-display" style="font-size: clamp(34px, 4.6vw, 62px)">{p.name}</h2>
                  <span class="lbl block mt-2">{p.stage}</span>
                </div>
                <button type="button" class="btn-view" data-flip-btn aria-expanded="false">{t.actions.readMore}</button>
              </div>
            </div>
          </article>

          <article class="card-page album-back flip-back" inert>
            <header class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
              <h3 class="t-h3">{p.name}</h3>
              <button type="button" class="lnk lnk-back" data-flip-btn aria-expanded="true">{t.actions.readLess}</button>
            </header>
            <p class="t-h3 mt-5 max-w-[44ch]" style="color: var(--mid); font-weight: 500">{p.h}</p>
            <div class="mt-7 grid gap-x-12 gap-y-6 sm:grid-cols-2">
              {p.more.map(([mh, mp]) => (
                <div>
                  <h4 class="lbl">{mh}</h4>
                  <p class="mt-2.5 text-[14.5px]" style="color: var(--mid)">{mp}</p>
                </div>
              ))}
            </div>
            <div class="mt-auto pt-6">
              <ExhibitActions slug={p.slug} />
            </div>
          </article>
        </div>
      </div>
    </section>
  ))}

  <!-- ── Cererile — exclusiv aici, în ordinea asta ── -->
  <section class="wrap sec rise">
    <SectionHead index="03" title={t.askLabel} />
    <AmbientCards n={2} />
    <article class="card-page float-card" data-tilt="1.5">
      <div class="max-w-[64ch]">
        <h3 class="t-h2 !text-[clamp(24px,3vw,34px)]">{t.ask1H}</h3>
        <p class="mt-4" style="color: var(--mid)">{t.ask1P}</p>
        <a href={`mailto:${email}`} class="btn mt-8">{t.ask1Cta}</a>

        <p class="row-line mt-12 text-[16px]" style="color: var(--mid)">{t.ask2}</p>
        <p class="text-[16px] pt-4" style="color: var(--mid)">{t.ask3} <a href={`mailto:${email}`} class="lnk !text-[14px]">{email}</a></p>
      </div>
    </article>
  </section>

  <script>
    /* Like + Comment — rulează doar dacă butoanele există în DOM
       (adică doar cu env-urile setate). Cusdis se încarcă la primul clic. */
    const store = {
      get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
      set(k: string) { try { localStorage.setItem(k, '1'); } catch { /* private mode */ } },
    };
    const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');

    document.querySelectorAll<HTMLButtonElement>('[data-like]').forEach((btn) => {
      const slug = btn.closest<HTMLElement>('[data-exhibit]')?.dataset.exhibit ?? '';
      const ep = btn.dataset.endpoint ?? '';
      const out = btn.querySelector('[data-count]');
      if (!slug || !ep || !out) return;
      let count = 0;
      if (store.get('liked:' + slug)) btn.classList.add('on');
      fetch(`${ep}?id=${slug}`)
        .then((r) => r.json())
        .then((d) => { count = d.count | 0; out.textContent = pad(count); })
        .catch(() => {});
      btn.addEventListener('click', () => {
        if (store.get('liked:' + slug)) return;
        store.set('liked:' + slug);
        btn.classList.add('on');
        out.textContent = pad(++count);
        fetch(ep, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: slug }),
        }).catch(() => {});
      });
    });

    let cusdisSdk: Promise<void> | null = null;
    const loadCusdis = () => (cusdisSdk ??= new Promise((res) => {
      const s = document.createElement('script');
      s.src = 'https://cusdis.com/js/cusdis.es.js';
      s.async = true;
      s.onload = () => res();
      document.body.appendChild(s);
    }));

    /* Flip „Read more" — fața devine inert cât e ascunsă (butoanele Like/
       Comment nu pot primi focus pe dos), și invers. Fără JS, cardul stă
       pe față și povestea lungă rămâne în DOM pentru SEO. */
    document.querySelectorAll<HTMLElement>('[data-flip]').forEach((card) => {
      const front = card.querySelector<HTMLElement>('.flip-front');
      const back = card.querySelector<HTMLElement>('.flip-back');
      if (!front || !back) return;
      const btns = card.querySelectorAll<HTMLButtonElement>('[data-flip-btn]');
      const set = (open: boolean) => {
        card.classList.toggle('open', open);
        front.inert = open;
        back.inert = !open;
        btns.forEach((b) => b.setAttribute('aria-expanded', String(open)));
      };
      btns.forEach((b) => b.addEventListener('click', () => set(!card.classList.contains('open'))));
    });

    document.querySelectorAll<HTMLButtonElement>('[data-comment]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const wrap = btn.closest('section')?.querySelector<HTMLElement>('[data-thread]');
        if (!wrap) return;
        const open = wrap.hidden;
        wrap.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (open && !wrap.dataset.loaded) {
          wrap.dataset.loaded = '1';
          await loadCusdis();
          const C = (window as any).CUSDIS;
          const el = wrap.querySelector('.cusdis-thread');
          if (C?.renderTo && el) C.renderTo(el);
          else C?.initial?.();
        }
      });
    });
  </script>

</Base>
