---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { copy, routes, type RouteKey } from '../copy';

interface Props { route: RouteKey; title: string; desc: string; noindex?: boolean; }
const { route, title, desc, noindex = false } = Astro.props;
const site = 'https://maquette.ro';
const t = copy;

---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#F4F2ED" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={site + routes[route]} />
  <script is:inline>
    // Înainte de primul paint. Elementele pornesc ascunse doar dacă avem
    // cu ce să le arătăm înapoi — fie scroll-driven nativ, fie JS.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-anim');
    }
  </script>
  <Font cssVariable="--font-figtree" preload />
  <Font cssVariable="--font-jbmono" />
</head>
<body class="relative bg-[var(--paper)]">

<header class="site-head">
  <div class="wrap flex items-center justify-between gap-6 py-5">
    <a href={routes.home} class="vt-mark text-[18px] font-bold tracking-[-.02em]">
      Maquette<span style="color: var(--red)">.</span>
    </a>

    <nav class="vt-nav hidden md:flex items-center gap-8">
      {t.nav.map(([key, label]) => (
        <a href={routes[key]} class="nav-lnk text-[14.5px]"
           aria-current={route === key ? 'page' : undefined}
           style={route === key ? 'color: var(--red)' : 'color: var(--mid)'}>{label}</a>
      ))}
    </nav>

    <a href={routes.contact} class="btn btn-quiet hidden sm:inline-flex !py-2.5 !px-5 !text-[14px]">{t.cta}</a>
  </div>

  <nav class="md:hidden wrap flex flex-wrap gap-5 pb-4">
    {t.nav.map(([key, label]) => (
      <a href={routes[key]} class="nav-lnk text-[14px]"
         aria-current={route === key ? 'page' : undefined}
         style={route === key ? 'color: var(--red)' : 'color: var(--mid)'}>{label}</a>
    ))}
  </nav>

  <div class="prog" aria-hidden="true"></div>
</header>

<main><slot /></main>

<footer class="border-t" style="border-color: var(--hairline); margin-top: var(--sec)">
  <div class="wrap py-14 grid gap-x-14 gap-y-10 md:grid-cols-[1.2fr_1.2fr_1fr]">
    <div class="grid gap-3 content-start">
      <span class="text-[18px] font-bold tracking-[-.02em]">Maquette<span style="color: var(--red)">.</span></span>
      <p class="text-[13.5px] max-w-[34ch]" style="color: var(--mid)">{t.footer.brandNote}</p>
    </div>

    <div class="grid content-start">
      <span class="lbl pb-2">{t.footer.contentsLabel}</span>
      {t.footer.contents.map(([key, label], i) => (
        <a href={routes[key]} class="toc-row">
          <span class="no">{String(i + 1).padStart(2, '0')}</span>
          <span>{label}</span>
          <i class="dots" aria-hidden="true"></i>
          <span class="path">{routes[key]}</span>
        </a>
      ))}
    </div>

    <div class="grid gap-1.5 text-[13px] content-start" style="color: var(--mid)">
      <span>{t.footer.legalName}</span>
      <span class="tabular">{t.footer.cui}</span>
      <span class="tabular">{t.footer.onrc}</span>
      <span>{t.footer.seat}</span>
      <div class="flex gap-4 pt-2">
        <a href="https://anpc.ro" rel="noopener" target="_blank">{t.footer.anpc}</a>
        <a href="https://ec.europa.eu/consumers/odr" rel="noopener" target="_blank">{t.footer.sol}</a>
      </div>
    </div>
  </div>
</footer>

<script>
  /* Fallback pentru browserele fără scroll-driven animations (Firefox, azi). */
  if (!CSS.supports('animation-timeline: view()')) {
    const els = document.querySelectorAll('.rise');
    if (els.length) {
      const io = new IntersectionObserver((entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('in');
          obs.unobserve(e.target);
        }
      }, { rootMargin: '0px 0px -12% 0px' });
      els.forEach((el) => io.observe(el));
    }
  }

  /* Cardurile plutitoare (.float-card): legănare lentă + tilt spre cursor.
     Limbajul de card al homepage-ului, continuat static pe restul paginilor.
     Tăcut la reduced-motion; tilt doar cu hover+pointer fin; cardurile din
     afara viewportului nu se animă. */
  const cards = [...document.querySelectorAll<HTMLElement>('.float-card')];
  if (cards.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const st = cards.map((el, i) => ({
      el, vis: false,
      ph: i * 1.7 + Math.random() * 2,
      amp: parseFloat(el.dataset.amp || '') || 6 + Math.random() * 2,
      rx: 0, ry: 0, tx: 0, ty: 0,
      g: 0, tg: 0, mx: 50, my: 50,   // reflexia „holo": intensitate + poziția cursorului
      tilt: parseFloat(el.dataset.tilt || '4.5'),
    }));
    const io2 = new IntersectionObserver((es) => {
      for (const e of es) { const c = st.find((x) => x.el === e.target); if (c) c.vis = e.isIntersecting; }
    });
    st.forEach((c) => io2.observe(c.el));
    if (fine) st.forEach((c) => {
      c.el.addEventListener('pointermove', (e) => {
        const r = c.el.getBoundingClientRect();
        c.tx = ((e.clientY - r.top) / r.height - .5) * -2 * c.tilt;
        c.ty = ((e.clientX - r.left) / r.width - .5) * 2 * c.tilt;
        c.mx = ((e.clientX - r.left) / r.width) * 100;
        c.my = ((e.clientY - r.top) / r.height) * 100;
        c.tg = 1;
      }, { passive: true });
      c.el.addEventListener('pointerleave', () => { c.tx = 0; c.ty = 0; c.tg = 0; });
    });
    const loop = (now: number) => {
      const t = now / 1000;
      for (const c of st) {
        if (!c.vis) continue;
        c.rx += (c.tx - c.rx) * .08;
        c.ry += (c.ty - c.ry) * .08;
        c.g += (c.tg - c.g) * .1;
        const bob = Math.sin(t * .9 + c.ph) * c.amp;
        c.el.style.transform =
          `perspective(900px) rotateX(${c.rx.toFixed(2)}deg) rotateY(${c.ry.toFixed(2)}deg) `
          + `translateY(${bob.toFixed(1)}px) scale(${(1 + c.g * .006).toFixed(4)})`;
        if (c.g > .002) {
          c.el.style.setProperty('--glare', c.g.toFixed(3));
          c.el.style.setProperty('--mx', c.mx.toFixed(1) + '%');
          c.el.style.setProperty('--my', c.my.toFixed(1) + '%');
        } else if (c.el.style.getPropertyValue('--glare')) {
          c.el.style.setProperty('--glare', '0');
        }
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>
</body>
</html>
